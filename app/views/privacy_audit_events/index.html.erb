<%= platform_settings_page(title: t('platform_settings.lgpd.title'), description: t('platform_settings.lgpd.description'), nav: :lgpd, max_width: 'max-w-[90rem]') do %>
  <section class="workspace-portlet">
    <%= workspace_panel_header(title: 'Trilha de auditoria', count: number_with_delimiter(@events_total_count)) %>

    <div class="workspace-table-wrap">
      <table class="workspace-table workspace-table--top">
        <thead>
          <tr>
            <th scope="col">Evento</th>
            <th scope="col">Autor</th>
            <th scope="col">Lote</th>
            <th scope="col">Recurso</th>
            <th scope="col">Detalhes</th>
            <th scope="col">Data e hora</th>
          </tr>
        </thead>
        <tbody>
          <% if @events.any? %>
            <% @events.each do |event| %>
              <tr>
                <td class="workspace-table__primary min-w-[12rem]"><%= event.action_label %></td>
                <td class="is-nowrap">
                  <% if event.performed_by %>
                    <%= event.performed_by.name %>
                  <% else %>
                    <span class="text-fg-muted" title="Ação automática, sem usuário">Sistema</span>
                  <% end %>
                </td>
                <td><%= event.supplier_import.present? ? workspace_code_tag(event.supplier_import.display_code) : content_tag(:span, '—', class: 'workspace-table__empty-dash') %></td>
                <td class="min-w-[9rem]">
                  <%= event.resource_type.presence || content_tag(:span, '—', class: 'workspace-table__empty-dash') %>
                  <% if event.resource_id.present? %>
                    <span class="workspace-table__secondary workspace-mono"><%= event.resource_id %></span>
                  <% end %>
                </td>
                <td class="min-w-[18rem] text-[0.8125rem] text-fg-muted">
                  <% if event.metadata.present? %>
                    <%= event.metadata.map { |key, value| "#{key}: #{value}" }.join(' · ') %>
                  <% else %>
                    <span class="workspace-table__empty-dash">—</span>
                  <% end %>
                </td>
                <td><%= workspace_datetime_cell(event.occurred_at) %></td>
              </tr>
            <% end %>
          <% else %>
            <%= workspace_empty_table_row(colspan: 6, message: 'Nenhum evento registrado.', hint: 'Importações, exportações, anonimizações e alterações de política aparecem aqui.') %>
          <% end %>
        </tbody>
      </table>
    </div>

    <%= render 'shared/pagination', current_page: @events_page, total_pages: @events_total_pages %>
  </section>
<% end %>
