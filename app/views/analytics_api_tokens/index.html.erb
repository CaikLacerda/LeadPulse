<%= platform_settings_page(title: "Integrações", description: "Provedores de voz e IA, token da API de validação e tokens de BI da empresa.") do %>
  <%= settings_panel do %>
    <%= settings_feedback_messages %>

    <%= settings_section(title: "Tokens de BI",
          description: "Acesso somente leitura ao Analytics desta empresa para Power BI, Tableau, Excel Power Query e outras ferramentas. Não servem para a API de validação.") do %>
      <% if @created_secret.present? %>
        <div class="workspace-callout workspace-callout--warning flex-col !items-stretch !gap-3 mb-5"
             data-controller="copy-to-clipboard"
             data-copy-to-clipboard-source-value="created_bi_token"
             data-copy-to-clipboard-default-text-value="Copiar"
             data-copy-to-clipboard-success-text-value="Copiado">
          <div>
            <label for="created_bi_token" class="font-medium text-fg">Copie o token agora</label>
            <p class="mt-0.5">Ele aparece somente nesta tela. Depois, o LeadPulse mostra apenas o prefixo e não consegue recuperá-lo.</p>
          </div>
          <div class="flex flex-col gap-2 sm:flex-row">
            <input type="text" id="created_bi_token" value="<%= @created_secret %>" readonly class="settings-input settings-input--mono">
            <button type="button" class="<%= workspace_button_class(:secondary) %>" data-copy-to-clipboard-target="button" data-action="copy-to-clipboard#copy">Copiar</button>
          </div>
        </div>
      <% end %>

      <%= form_with model: @new_token, url: analytics_api_tokens_path, class: "bi-token-form" do |f| %>
        <div class="bi-token-form__field">
          <%= f.label :name, "Nome do token", class: "settings-label" %>
          <%= f.text_field :name, required: true, maxlength: 80, placeholder: "Ex.: Power BI Financeiro", class: "settings-input" %>
        </div>
        <%= f.submit "Criar token", class: workspace_submit_class(:primary), data: { turbo_submits_with: "Criando…" } %>
      <% end %>
    <% end %>
  <% end %>

  <section class="workspace-portlet mt-6">
    <%= workspace_panel_header(title: "Tokens da empresa", count: "#{@tokens.count(&:active?)} ativos") %>
    <div class="workspace-table-wrap">
      <table class="workspace-table">
        <thead>
          <tr>
            <th scope="col">Nome</th>
            <th scope="col">Prefixo</th>
            <th scope="col">Criado por</th>
            <th scope="col">Criado em</th>
            <th scope="col">Último uso</th>
            <th scope="col">Status</th>
            <th scope="col" class="is-actions"><span class="sr-only">Ações</span></th>
          </tr>
        </thead>
        <tbody>
          <% if @tokens.any? %>
            <% @tokens.each do |token| %>
              <tr class="<%= 'team-table__row--muted' unless token.active? %>">
                <td class="workspace-table__primary"><%= token.name %></td>
                <td><span class="workspace-compact-code"><%= token.token_prefix %>…</span></td>
                <td><%= token.created_by&.name || "—" %></td>
                <td><%= workspace_datetime_cell(token.created_at) %></td>
                <td><%= token.last_used_at ? workspace_datetime_cell(token.last_used_at) : content_tag(:span, "Nunca usado", class: "text-fg-muted") %></td>
                <td>
                  <% if token.active? %>
                    <%= status_badge("Ativo", tone: :success) %>
                  <% else %>
                    <%= status_badge("Revogado", tone: :neutral, title: "Revogado em #{workspace_datetime(token.revoked_at)}#{" por #{token.revoked_by.name}" if token.revoked_by}") %>
                  <% end %>
                </td>
                <td class="is-actions">
                  <% if token.active? %>
                    <%= button_to "Revogar", analytics_api_token_path(token), method: :delete,
                          class: workspace_button_class(:ghost, "text-danger-fg", size: :sm),
                          form: { data: { turbo_confirm: "Integrações que usam \"#{token.name}\" deixam de funcionar imediatamente.", turbo_confirm_title: "Revogar token?", turbo_confirm_confirm_label: "Revogar", turbo_confirm_cancel_label: "Cancelar", turbo_confirm_variant: "danger" } } %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          <% else %>
            <%= workspace_empty_table_row(colspan: 7, message: "Nenhum token de BI criado.", hint: "Crie um token para conectar Power BI, Tableau ou Power Query à API de Analytics.") %>
          <% end %>
        </tbody>
      </table>
    </div>
    <p class="analytics-chart__note">Como consultar: <%= link_to "API para desenvolvedores → API de Analytics", developer_docs_path(anchor: "analytics-api"), class: "workspace-link" %>.</p>
  </section>
<% end %>
