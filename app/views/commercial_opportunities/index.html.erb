<% remote_status_urls = if current_user.can_start_validation?
     @opportunities.select { |item| item.processing? && item.syncable? }
       .map { |item| sync_status_commercial_opportunity_path(item, format: :json) }
   else
     []
   end %>

<div data-controller="remote-status-poll"
     data-remote-status-poll-urls-value="<%= remote_status_urls.to_json %>">
<%= workspace_page do %>
  <%= workspace_page_header(
    kicker: 'Operação comercial',
    title: 'Retornos comerciais',
    description: 'Fornecedores que aceitaram um novo contato e aguardam a coleta de condições comerciais.'
  ) %>

  <section class="mb-6 grid gap-3 md:grid-cols-3">
    <%= workspace_metric_card(
      label: 'Aguardando início',
      value: @status_counts.fetch(CommercialOpportunity::STATUS_PENDING, 0),
      description: 'Retornos liberados para início manual.',
      icon: :clock
    ) %>
    <%= workspace_metric_card(
      label: 'Em andamento',
      value: @status_counts.fetch(CommercialOpportunity::STATUS_PROCESSING, 0),
      description: 'Chamadas iniciadas ou aguardando atualização.',
      icon: :clock
    ) %>
    <%= workspace_metric_card(
      label: 'Concluídos',
      value: @status_counts.fetch(CommercialOpportunity::STATUS_COMPLETED, 0),
      description: 'Coletas disponíveis para revisão.',
      icon: :validation
    ) %>
  </section>

  <%= portlet_search do %>
    <%= form_with url: commercial_opportunities_path, method: :get, local: true do |f| %>
      <div class="grid gap-3 lg:grid-cols-[minmax(0,1fr)_220px_auto]">
        <%= f.text_field :q,
          value: params[:q],
          placeholder: 'Buscar por código, fornecedor ou telefone',
          class: 'settings-input' %>
        <%= f.select :status,
          [['Todos os status', '']] + CommercialOpportunity::STATUSES.map { |status| [local_status_label(status), status] },
          { selected: params[:status] },
          class: 'settings-input appearance-none' %>
        <div class="flex gap-2">
          <%= workspace_link_button 'Limpar', commercial_opportunities_path %>
          <%= workspace_button_tag type: :submit do %>
            <%= workspace_icon(:filter) %><span>Filtrar</span>
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>

  <% table_meta = content_tag(:span, "#{@opportunities_total_count} registro(s)", class: 'workspace-portlet-meta') %>
  <%= portlet_form('Fila de fornecedores', table_meta, icon: :commercial, body_class: 'workspace-portlet-body--flush') do %>
    <div class="overflow-x-auto overflow-y-visible">
      <table class="workspace-table">
        <thead>
          <tr>
            <th>Retorno</th>
            <th>Fornecedor</th>
            <th>Telefone</th>
            <th>Preferência informada</th>
            <th>Origem</th>
            <th>Status</th>
            <th>Ações</th>
          </tr>
        </thead>
        <tbody>
          <% if @opportunities.any? %>
            <% @opportunities.each do |opportunity| %>
              <tr>
                <td><%= workspace_code_tag(opportunity.display_code, commercial_opportunity_path(opportunity)) %></td>
                <td>
                  <p class="font-semibold text-slate-900"><%= opportunity.supplier_name %></p>
                  <p class="mt-1 text-xs text-slate-500"><%= opportunity.segment_name.presence || 'Segmento não informado' %></p>
                </td>
                <td>
                  <p class="font-medium text-slate-800"><%= opportunity.callback_phone %></p>
                  <p class="mt-1 text-xs text-slate-500"><%= opportunity.callback_phone_choice_label %></p>
                </td>
                <td class="max-w-xs">
                  <p class="text-sm font-medium text-slate-800"><%= opportunity.callback_schedule_label %></p>
                  <% if opportunity.callback_preferred_at.present? && opportunity.callback_preferred_time.present? %>
                    <p class="mt-1 text-xs text-slate-500"><%= opportunity.callback_preferred_time %></p>
                  <% end %>
                </td>
                <td><%= workspace_code_tag(opportunity.source_import_code, supplier_import_path(opportunity.supplier_import)) %></td>
                <td><%= workspace_status_tag(opportunity.status) %></td>
                <td class="whitespace-nowrap">
                  <details data-controller="action-menu" class="relative inline-block">
                    <summary class="workspace-summary-button">Ações</summary>
                    <div class="workspace-menu absolute right-0 top-[calc(100%+0.25rem)] z-20 w-48 p-1">
                      <%= link_to 'Ver detalhes', commercial_opportunity_path(opportunity), class: 'workspace-menu-item' %>
                      <% if opportunity.startable? && current_user.can_start_validation? %>
                        <%= button_to 'Iniciar coleta', start_commercial_opportunity_path(opportunity), method: :post, class: 'workspace-menu-item' %>
                      <% end %>
                      <% if opportunity.syncable? && current_user.can_start_validation? %>
                        <%= button_to 'Consultar status', sync_status_commercial_opportunity_path(opportunity), method: :post, class: 'workspace-menu-item' %>
                      <% end %>
                      <% if opportunity.ready_to_export? && current_user.can_export_data? %>
                        <%= link_to 'Exportar XLSX', export_commercial_opportunity_path(opportunity), data: { turbo: false }, class: 'workspace-menu-item' %>
                      <% end %>
                    </div>
                  </details>
                </td>
              </tr>
            <% end %>
          <% else %>
            <%= workspace_empty_table_row(colspan: 7, message: 'Nenhum fornecedor aceitou retorno comercial até o momento.') %>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="border-t border-slate-200 px-4 py-3">
      <%= render 'shared/pagination', current_page: @opportunities_page, total_pages: @opportunities_total_pages %>
    </div>
  <% end %>
<% end %>
</div>
