<% if total_pages.to_i > 1 %>
  <% base_params = request.query_parameters.except(:page) %>
  <div class="workspace-pagination">
    <p class="workspace-pagination__summary">
      <%= t('shared.pagination.page_of', page: content_tag(:strong, current_page), total: content_tag(:strong, total_pages)).html_safe %>
    </p>

    <nav class="workspace-pagination__nav" aria-label="<%= t('shared.pagination.aria') %>">
      <% if current_page > 1 %>
        <%= link_to url_for(base_params.merge(page: current_page - 1)), class: 'workspace-pagination__link', rel: 'prev' do %>
          <i class="fa-solid fa-chevron-left text-[0.625rem]" aria-hidden="true"></i><span><%= t('shared.pagination.previous') %></span>
        <% end %>
      <% else %>
        <span class="workspace-pagination__link workspace-pagination__link--disabled" aria-disabled="true">
          <i class="fa-solid fa-chevron-left text-[0.625rem]" aria-hidden="true"></i><span><%= t('shared.pagination.previous') %></span>
        </span>
      <% end %>

      <% pagination_series(current_page, total_pages).each do |item| %>
        <% if item == :gap %>
          <span class="workspace-pagination__gap" aria-hidden="true">…</span>
        <% elsif item == current_page %>
          <span class="workspace-pagination__link workspace-pagination__link--current" aria-current="page"><%= item %></span>
        <% else %>
          <%= link_to item, url_for(base_params.merge(page: item)), class: 'workspace-pagination__link' %>
        <% end %>
      <% end %>

      <% if current_page < total_pages %>
        <%= link_to url_for(base_params.merge(page: current_page + 1)), class: 'workspace-pagination__link', rel: 'next' do %>
          <span><%= t('shared.pagination.next') %></span><i class="fa-solid fa-chevron-right text-[0.625rem]" aria-hidden="true"></i>
        <% end %>
      <% else %>
        <span class="workspace-pagination__link workspace-pagination__link--disabled" aria-disabled="true">
          <span><%= t('shared.pagination.next') %></span><i class="fa-solid fa-chevron-right text-[0.625rem]" aria-hidden="true"></i>
        </span>
      <% end %>
    </nav>
  </div>
<% end %>
