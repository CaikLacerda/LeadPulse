<%# Tela real com srcset e dimensões explícitas. Todos os dados das imagens são de demonstração. %>
<% priority = local_assigns.fetch(:priority, false) %>
<figure class="product-screenshot <%= local_assigns[:css_class] %>">
  <div class="product-screenshot__frame">
    <%= image_tag "landing/#{image}-#{width}.webp",
          srcset: { "landing/#{image}-#{small_width}.webp" => "#{small_width}w", "landing/#{image}-#{width}.webp" => "#{width}w" },
          sizes: sizes, width: width, height: height,
          loading: (priority ? 'eager' : 'lazy'), fetchpriority: (priority ? 'high' : nil), decoding: 'async', alt: alt %>
  </div>
  <figcaption class="product-screenshot__caption"><%= caption %></figcaption>
</figure>
