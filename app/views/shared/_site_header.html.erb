<%# Header público (landing, termos e privacidade). O workspace autenticado usa shared/_app_sidebar e shared/_app_topbar. %>
<% marketing_items = [
  [t('shared.header.marketing.home'), root_path(anchor: 'inicio')],
  [t('shared.header.marketing.resources'), root_path(anchor: 'recursos')],
  [t('shared.header.marketing.plans'), root_path(anchor: 'planos')],
  [t('shared.header.marketing.about'), root_path(anchor: 'sobre')],
  [t('shared.header.marketing.contact'), root_path(anchor: 'contato')]
] %>

<header class="site-header" data-controller="nav" data-action="keydown.esc@window->nav#close">
  <div class="site-header__inner">
    <%= link_to root_path, class: 'site-header__brand' do %>
      <span class="app-logo-mark" aria-hidden="true"><i class="fa-solid fa-bolt"></i></span>
      <span class="app-logo-text">LeadPulse</span>
    <% end %>

    <nav class="site-nav" aria-label="Navegação principal">
      <% marketing_items.each do |label, path| %>
        <%= link_to label, path, class: 'site-nav__link' %>
      <% end %>
    </nav>

    <div class="site-header__actions">
      <%= link_to t('shared.header.session.sign_in'), new_user_session_path, class: 'site-nav__link' %>
      <%= link_to 'Criar conta', new_user_registration_path, class: workspace_button_class(:primary) %>
    </div>

    <button type="button"
            class="site-header__toggle"
            aria-label="<%= t('shared.header.session.open_menu') %>"
            aria-expanded="false"
            aria-controls="site-mobile-menu"
            data-nav-target="button"
            data-action="nav#toggle">
      <i class="fa-solid fa-bars" aria-hidden="true"></i>
      <i class="fa-solid fa-xmark" aria-hidden="true"></i>
    </button>
  </div>

  <div id="site-mobile-menu" class="site-mobile-menu hidden" data-nav-target="panel">
    <nav aria-label="Menu">
      <% marketing_items.each do |label, path| %>
        <%= link_to label, path, class: 'site-mobile-menu__link', data: { action: 'nav#close' } %>
      <% end %>
    </nav>
    <div class="site-mobile-menu__actions">
      <%= link_to t('shared.header.session.sign_in'), new_user_session_path, class: workspace_button_class(:secondary, nil, size: :lg) %>
      <%= link_to 'Criar conta', new_user_registration_path, class: workspace_button_class(:primary, nil, size: :lg) %>
    </div>
  </div>
</header>
