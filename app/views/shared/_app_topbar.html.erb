<% trail = workspace_breadcrumb_trail %>
<% account_display_name = current_user.validation_owner_name_value.presence || current_user.email.to_s.split('@').first.presence || t('shared.header.session.account') %>
<% account_initials = account_display_name.to_s.split(/\s+/).first(2).filter_map { |part| part[0] }.join.upcase.first(2).presence || 'LP' %>
<% notifications = workspace_notifications %>
<% unread_notifications = notifications.reject { |notification| notification[:read] } %>

<header class="app-topbar">
  <button type="button"
          class="app-icon-button app-topbar__menu"
          data-sidebar-target="menuButton"
          data-action="sidebar#openMobile"
          aria-controls="app-sidebar"
          aria-expanded="false"
          aria-label="<%= t('shared.header.session.open_menu') %>">
    <i class="fa-solid fa-bars" aria-hidden="true"></i>
  </button>

  <% if trail.any? %>
    <nav class="app-breadcrumb" aria-label="Você está em">
      <ol>
        <% trail.each_with_index do |(label, path), index| %>
          <li>
            <% if path.present? %>
              <%= link_to label, path %>
            <% elsif index == trail.size - 1 %>
              <span aria-current="page"><%= label %></span>
            <% else %>
              <span><%= label %></span>
            <% end %>
          </li>
        <% end %>
      </ol>
    </nav>
  <% end %>

  <div class="app-topbar__actions">
    <% if content_for?(:workspace_tutorial) %>
      <button type="button" class="app-topbar__help" data-controller="tutorial-launcher" data-action="tutorial-launcher#launch">
        <i class="fa-solid fa-circle-question" aria-hidden="true"></i>
        <span>Guia da tela</span>
      </button>
    <% end %>

    <details data-controller="action-menu notification-read"
             data-notification-read-url-value="<%= mark_notifications_read_path %>"
             data-notification-read-keys-value="<%= unread_notifications.pluck(:key).to_json %>"
             class="app-notifications relative">
      <summary class="app-icon-button" aria-label="Notificações" title="Notificações">
        <%= workspace_icon(:bell) %>
        <% if unread_notifications.any? %>
          <span class="app-notification-badge" data-notification-read-target="badge"><%= unread_notifications.size > 9 ? '9+' : unread_notifications.size %></span>
        <% end %>
      </summary>

      <div class="app-notification-menu absolute right-0 top-[calc(100%+0.5rem)] z-50">
        <div class="app-notification-menu__header">
          <p class="app-notification-menu__title">Notificações</p>
          <% if unread_notifications.any? %>
            <span class="app-notification-menu__count" data-notification-read-target="count"><%= unread_notifications.size %> não lida<%= 's' if unread_notifications.size != 1 %></span>
          <% end %>
        </div>

        <div class="app-notification-menu__list">
          <% if notifications.any? %>
            <% notifications.each do |notification| %>
              <%= link_to notification[:path],
                  class: "app-notification-item #{notification[:read] ? 'app-notification-item--read' : 'app-notification-item--unread'}",
                  data: (notification[:read] ? {} : { notification_read_target: 'item' }) do %>
                <span class="app-notification-item__icon"><%= workspace_icon(notification[:icon]) %></span>
                <span class="app-notification-item__copy">
                  <strong><%= notification[:title] %></strong>
                  <span><%= notification[:body] %></span>
                </span>
              <% end %>
            <% end %>
          <% else %>
            <div class="app-notification-empty">
              <strong>Nenhuma pendência</strong>
              <span>Avisos sobre lotes e retornos aparecem aqui.</span>
            </div>
          <% end %>
        </div>

        <% if current_user.can_view_evidence? %>
          <%= link_to validation_audits_path, class: 'app-notification-menu__footer' do %>
            <span>Ver auditoria de chamadas</span><i class="fa-solid fa-arrow-right text-xs" aria-hidden="true"></i>
          <% end %>
        <% end %>
      </div>
    </details>

    <span class="app-topbar__divider" aria-hidden="true"></span>

    <details data-controller="action-menu" class="relative">
      <summary class="app-account-summary" aria-label="Conta de <%= account_display_name %>">
        <span class="app-account-avatar" aria-hidden="true"><%= account_initials %></span>
        <span class="app-account-summary__identity">
          <span class="app-account-summary__name"><%= account_display_name %></span>
          <span class="app-account-summary__company"><%= current_user.validation_company_name_value %></span>
        </span>
        <i class="app-account-summary__chevron fa-solid fa-chevron-down" aria-hidden="true"></i>
      </summary>

      <div class="workspace-menu absolute right-0 top-[calc(100%+0.375rem)] z-50 w-64">
        <div class="app-account-menu__header">
          <p class="app-account-menu__title"><%= current_user.validation_company_name_value %></p>
          <p class="app-account-menu__subtitle"><%= current_user.email %></p>
          <p class="app-account-menu__role"><span class="workspace-tag"><%= current_user.role_label %></span></p>
        </div>

        <%= link_to edit_user_registration_path, class: 'workspace-menu-item' do %>
          <i class="fa-solid fa-user" aria-hidden="true"></i><span>Minha conta</span>
        <% end %>
        <% if current_user.can_manage_settings? %>
          <%= link_to company_platform_settings_path, class: 'workspace-menu-item' do %>
            <i class="fa-solid fa-building" aria-hidden="true"></i><span>Dados da empresa</span>
          <% end %>
        <% end %>
        <%= link_to developer_docs_path, class: 'workspace-menu-item' do %>
          <i class="fa-solid fa-code" aria-hidden="true"></i><span>API para desenvolvedores</span>
        <% end %>

        <div class="workspace-menu-separator" role="separator"></div>

        <div class="app-theme-switch" data-controller="appearance">
          <span class="app-theme-switch__label" id="app-theme-label">Tema</span>
          <div class="app-theme-switch__options" role="group" aria-labelledby="app-theme-label">
            <% AppearanceHelper::THEMES.each do |value, option| %>
              <button type="button"
                      class="app-theme-switch__option"
                      title="<%= option[:label] %>"
                      aria-pressed="<%= workspace_theme == value %>"
                      data-appearance-target="option"
                      data-appearance-theme-param="<%= value %>"
                      data-action="appearance#select">
                <i class="fa-solid <%= option[:icon] %>" aria-hidden="true"></i>
                <span class="sr-only"><%= option[:label] %></span>
              </button>
            <% end %>
          </div>
        </div>

        <div class="workspace-menu-separator" role="separator"></div>

        <%= button_to destroy_user_session_path, method: :delete, class: 'workspace-menu-item workspace-menu-item--danger' do %>
          <i class="fa-solid fa-arrow-right-from-bracket" aria-hidden="true"></i><span><%= t('shared.header.session.sign_out') %></span>
        <% end %>
      </div>
    </details>
  </div>
</header>
