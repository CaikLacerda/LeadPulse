<% notes = [
  ['Cadastro e token', 'A conta operacional e o primeiro token são criados no LeadPulse. Depois disso, o integrador externo trabalha apenas com a API autenticada por Bearer token.'],
  ['Busca e validação', 'A busca estruturada é persistida, inclui a localização obtida pelo OpenStreetMap quando disponível e pode originar um lote de validação de segmento.'],
  ['Telefone E.164', 'O padrão operacional é E.164 com sinal +, no formato +55DDDNÚMERO. Entradas antigas sem + continuam aceitas e são normalizadas antes do envio.'],
  ['ERP', 'A integração com ERP consome os endpoints públicos por Bearer token: envio de lote, consulta de status e leitura do resultado para atualizar o cadastro externo.']
] %>

<%= workspace_page(max_width: 'max-w-6xl') do %>
  <%= workspace_page_header(
    title: 'API para desenvolvedores',
    description: 'Integre ERP, CRM ou backoffice à API de validação usando o Bearer token gerado nas configurações da conta.'
  ) do %>
    <% if current_user.can_manage_settings? %>
      <%= workspace_link_button api_token_platform_settings_path, variant: :secondary do %>
        <%= workspace_icon(:key) %><span>Gerenciar token</span>
      <% end %>
    <% end %>
  <% end %>

  <div class="mb-8 grid gap-6 lg:grid-cols-2">
    <%= portlet_form('Conexão', [], body_class: 'workspace-portlet-body--flush') do %>
      <dl class="workspace-definition-list">
        <%= workspace_definition_row(label: 'Base URL') do %>
          <span class="workspace-mono"><%= @api_base_url %></span>
        <% end %>
        <%= workspace_definition_row(label: 'Conta') do %>
          <span class="workspace-mono"><%= current_user.validation_account_id.presence || 'não provisionada' %></span>
        <% end %>
        <%= workspace_definition_row(label: 'Token') do %>
          <%= current_user.validation_api_token_configured? ? status_badge('Ativo', tone: :success) : status_badge('Pendente', tone: :warning) %>
        <% end %>
        <% @auth_modes.each do |mode| %>
          <%= workspace_definition_row(label: 'Autenticação') do %>
            <span class="workspace-mono"><%= mode[:auth] %></span>
            <p class="mt-1 text-[0.8125rem] text-fg-muted"><%= mode[:description] %></p>
          <% end %>
        <% end %>
      </dl>
    <% end %>

    <%= portlet_form('Primeiros passos', []) do %>
      <ol class="grid gap-2.5">
        <% @getting_started.each_with_index do |step, index| %>
          <li class="flex gap-3 text-sm leading-6 text-fg-secondary">
            <span class="mt-0.5 inline-flex h-5 w-5 flex-none items-center justify-center rounded-full border border-line text-[0.6875rem] font-medium text-fg-muted tabular-nums"><%= index + 1 %></span>
            <span><%= step %></span>
          </li>
        <% end %>
      </ol>
    <% end %>
  </div>

  <section class="mb-8">
    <h2 class="workspace-section-title">Fluxos disponíveis</h2>
    <dl class="mt-3 grid gap-x-8 gap-y-4 border-t border-line pt-4 sm:grid-cols-2">
      <% @integration_types.each do |integration| %>
        <div>
          <dt class="text-sm font-medium text-fg"><%= integration[:title] %></dt>
          <dd class="mt-0.5 text-[0.8125rem] leading-5 text-fg-muted"><%= integration[:description] %></dd>
        </div>
      <% end %>
    </dl>
  </section>

  <% @public_endpoint_groups.each do |group| %>
    <section class="mb-8">
      <h2 class="workspace-section-title"><%= group[:title] %></h2>
      <p class="workspace-section-description"><%= group[:description] %></p>

      <div class="workspace-portlet mt-3">
        <% group[:items].each do |endpoint| %>
          <article class="developer-endpoint">
            <div class="developer-endpoint__heading">
              <span class="developer-method developer-method--<%= endpoint[:method].downcase %>"><%= endpoint[:method] %></span>
              <code class="developer-endpoint__path"><%= endpoint[:path] %></code>
              <h3 class="developer-endpoint__title sm:ml-2"><%= endpoint[:title] %></h3>
            </div>
            <p class="developer-endpoint__description"><%= endpoint[:description] %></p>
            <p class="mt-1 text-[0.8125rem] text-fg-muted">Autenticação: <code class="developer-inline-code"><%= endpoint[:auth] %></code></p>

            <div class="developer-endpoint__examples">
              <div class="min-w-0">
                <p class="developer-code-label">Request</p>
                <pre class="developer-code-block"><code><%= endpoint[:request] %></code></pre>
              </div>
              <div class="min-w-0">
                <p class="developer-code-label">Response</p>
                <pre class="developer-code-block"><code><%= endpoint[:response] %></code></pre>
              </div>
            </div>
          </article>
        <% end %>
      </div>
    </section>
  <% end %>

  <section>
    <h2 class="workspace-section-title">Observações</h2>
    <dl class="mt-3 grid gap-x-8 gap-y-4 border-t border-line pt-4 sm:grid-cols-2">
      <% notes.each do |title, body| %>
        <div>
          <dt class="text-sm font-medium text-fg"><%= title %></dt>
          <dd class="mt-0.5 text-[0.8125rem] leading-5 text-fg-muted"><%= body %></dd>
        </div>
      <% end %>
    </dl>
  </section>
<% end %>
