<!DOCTYPE html>
<%# A landing e as páginas públicas têm visual próprio e ficam sempre no tema claro. %>
<% page_theme = user_signed_in? ? html_theme_attribute : 'light' %>
<html <%= tag.attributes(lang: I18n.locale, data: { theme: page_theme }) %>>
  <head>
    <title><%= content_for(:title) || t('shared.app_name') %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Leadpulse">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="apple-touch-icon" href="/icon.png">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" referrerpolicy="no-referrer">
    <%= stylesheet_link_tag :app, 'data-turbo-track': 'reload' %>
    <%= javascript_importmap_tags %>
  </head>

  <% if user_signed_in? %>
    <body class="app-body" <%= tag.attributes(data: { page_theme: page_theme }) %>>
      <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:rounded-md focus:bg-surface focus:px-3 focus:py-2 focus:text-sm focus:shadow">Ir para o conteúdo</a>

      <div class="app-shell <%= 'app-shell--collapsed' if workspace_sidebar_collapsed? %>" data-controller="sidebar">
        <%= render 'shared/app_sidebar' %>
        <div class="app-sidebar-backdrop" data-action="click->sidebar#closeMobile" aria-hidden="true"></div>

        <div class="app-frame">
          <%= render 'shared/app_topbar' %>
          <main class="app-content" id="main-content">
            <%= yield %>
          </main>
        </div>
      </div>

      <%= render 'shared/flash_messages' %>
    </body>
  <% else %>
    <body class="app-body--public min-h-screen bg-white text-gray-900" data-page-theme="light">
      <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:rounded-md focus:bg-surface focus:px-3 focus:py-2 focus:text-sm focus:shadow">Ir para o conteúdo</a>
      <%= render 'shared/site_header' %>
      <main class="app-main" id="main-content">
        <%= render 'shared/flash_messages' %>
        <%= yield %>
      </main>
      <%= render 'shared/site_footer' %>
    </body>
  <% end %>
</html>
