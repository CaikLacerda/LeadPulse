<!DOCTYPE html>
<html <%= tag.attributes(lang: 'pt-BR', data: { theme: html_theme_attribute }) %>>
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= content_for(:title) || 'LeadPulse' %></title>
    <meta name="description" content="<%= content_for(:description).presence || 'Acesse o LeadPulse: busca de fornecedores, validação por voz com IA e auditoria das chamadas.' %>">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" referrerpolicy="no-referrer">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="auth-body" <%= tag.attributes(data: { page_theme: html_theme_attribute }) %>>
    <a href="#auth-content" class="auth-skip-link">Ir para o formulário</a>

    <div class="auth-layout">
      <%= render 'devise/shared/brand_panel', variant: content_for(:auth_brand).presence || 'login' %>

      <main class="auth-main" id="auth-content">
        <div class="auth-panel <%= content_for(:auth_panel_class) %>">
          <%= yield %>
        </div>

        <footer class="auth-legal auth-legal--compact">
          <span>© <%= Date.current.year %> LeadPulse</span>
          <%= link_to 'Termos', terms_path %>
          <%= link_to 'Privacidade', privacy_path %>
        </footer>
      </main>
    </div>
  </body>
</html>
