<%# Ilustração decorativa: CSS usa os data-state dos participantes; nenhum relógio ou fluxo de áudio novo. %>
<div class="sim-orb" aria-hidden="true">
  <span class="sim-orb__halo"></span>
  <span class="sim-orb__orbit sim-orb__orbit--outer"></span>
  <span class="sim-orb__orbit sim-orb__orbit--inner"></span>
  <span class="sim-orb__satellite"></span>
  <div class="sim-orb__sphere">
    <span class="sim-orb__current"></span>
    <span class="sim-orb__light"></span>
  </div>
  <span class="sim-orb__equator"></span>
</div>
