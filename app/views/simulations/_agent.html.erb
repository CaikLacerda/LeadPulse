<%# Um lado do palco: avatar com estado (listening/thinking/speaking) e nível de voz.
    O Stimulus controla os mesmos data-attributes e a variável --sim-level. %>
<div class="sim-agent sim-agent--<%= side %>"
     data-simulation-live-target="<%= side == "agent" ? "agentCard" : "counterpartCard" %>"
     data-state="<%= initial_state %>" role="group" aria-label="<%= title %>">
  <div class="sim-agent__orb">
    <span class="sim-agent__ring" aria-hidden="true"></span>
    <span class="sim-agent__ring sim-agent__ring--2" aria-hidden="true"></span>
    <span class="sim-agent__avatar" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <% if side == "agent" %>
          <path d="M4 13v-2a8 8 0 0 1 16 0v2M8 18H6a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h2v7Zm8 0h2a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2h-2v7ZM18 18c0 2-2 3-5 3" />
        <% else %>
          <path d="M4 21V5a2 2 0 0 1 2-2h9v18M15 9h3a2 2 0 0 1 2 2v10M2 21h20M8 7h3M8 11h3M8 15h3M8 21v-3h3v3" />
        <% end %>
      </svg>
    </span>
  </div>
  <p class="sim-agent__caption"><%= caption %></p>
  <h2 class="sim-agent__name"><%= title %></h2>
  <div class="sim-agent__waveform" aria-hidden="true"
       data-simulation-live-target="<%= side == "agent" ? "waveAgent" : "waveCounterpart" %>">
    <% [8, 15, 24, 17, 30, 21, 26, 13, 7].each do |height| %>
      <span style="--bar-height: <%= height %>px"></span>
    <% end %>
  </div>
  <p class="sim-agent__state" data-simulation-live-target="<%= side == "agent" ? "agentState" : "counterpartState" %>"
     data-label-listening="<%= t("simulations.states.listening") %>"
     data-label-thinking="<%= t("simulations.states.thinking") %>"
     data-label-speaking="<%= t("simulations.states.speaking") %>">
    <%= t("simulations.states.#{initial_state}") %>
  </p>
</div>
