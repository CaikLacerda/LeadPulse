<% custom_visible = @filters.custom? || @filters.custom_requested? %>
<% filtered = @filters.to_params.any? %>

<%= form_with url: request.path, method: :get, class: "analytics-filters",
    aria: { label: t("analytics.filters.aria") },
    data: { controller: "analytics-filters", action: "change->analytics-filters#change submit->analytics-filters#clean" } do |f| %>
  <% active_filters = [@filters.workflow_kind, @filters.source, @filters.supplier_import_id, @filters.status].compact.size %>
  <button type="button" class="<%= workspace_button_class(:secondary, "analytics-filters__toggle") %>"
          aria-expanded="false" aria-controls="analytics-filters-fields"
          data-analytics-filters-target="toggle" data-action="analytics-filters#toggleFields">
    <%= workspace_icon(:filter) %>
    <span><%= t("analytics.filters.toggle") %></span>
    <% if active_filters.positive? %>
      <span class="analytics-filters__count"><%= active_filters %></span>
    <% end %>
  </button>

  <div class="analytics-filters__row" id="analytics-filters-fields" data-analytics-filters-target="fields">
    <%= f.select :periodo,
        Analytics::Filters::PERIODS.map { |period| [t("analytics.filters.periods.#{period}"), period] },
        { selected: custom_visible ? Analytics::Filters::PERIOD_CUSTOM : @filters.period },
        class: "settings-input analytics-filters__select",
        aria: { label: t("analytics.filters.period") },
        data: { analytics_filters_target: "period", default: Analytics::Filters::DEFAULT_PERIOD } %>

    <div class="analytics-filters__custom" data-analytics-filters-target="custom" <%= "hidden" unless custom_visible %>>
      <label class="analytics-filters__date">
        <span><%= t("analytics.filters.from") %></span>
        <%= f.date_field :de, value: (@filters.window.first_day if @filters.custom?), max: Date.current,
            class: "settings-input", data: { analytics_filters_target: "from" } %>
      </label>
      <label class="analytics-filters__date">
        <span><%= t("analytics.filters.to") %></span>
        <%= f.date_field :ate, value: (@filters.window.last_day if @filters.custom?), max: Date.current,
            class: "settings-input", data: { analytics_filters_target: "to" } %>
      </label>
    </div>

    <%= f.select :comparar,
        Analytics::Filters::COMPARISONS.map { |comparison| [t("analytics.filters.comparisons.#{comparison}"), comparison] },
        { selected: @filters.comparison },
        class: "settings-input analytics-filters__select",
        aria: { label: t("analytics.filters.compare") },
        data: { default: Analytics::Filters::COMPARE_PREVIOUS } %>

    <%= f.select :fluxo,
        [[t("analytics.filters.all_workflows"), ""]] + SupplierImport::WORKFLOW_KIND_LABELS.map { |value, label| [label, value] },
        { selected: @filters.workflow_kind },
        class: "settings-input analytics-filters__select", aria: { label: t("analytics.filters.workflow") } %>

    <%= f.select :origem,
        [[t("analytics.filters.all_sources"), ""]] + SupplierImport::SOURCE_LABELS.map { |value, label| [label, value] },
        { selected: @filters.source },
        class: "settings-input analytics-filters__select", aria: { label: t("analytics.filters.source") } %>

    <%= f.select :lote,
        [[t("analytics.filters.all_batches"), ""]] + @scope.batch_options.map { |id| [analytics_batch_code(id), id] },
        { selected: @filters.supplier_import_id },
        class: "settings-input analytics-filters__select", aria: { label: t("analytics.filters.batch") } %>

    <% if action_name == "batches" %>
      <%= f.select :status,
          [[t("analytics.filters.all_statuses"), ""]] + Analytics::Filters::STATUSES.map { |status| [local_status_label(status), status] },
          { selected: @filters.status },
          class: "settings-input analytics-filters__select", aria: { label: t("analytics.filters.status") } %>
    <% end %>

    <%= hidden_field_tag :agrupar, params[:agrupar], id: nil if params[:agrupar].present? %>

    <div class="analytics-filters__actions">
      <%= workspace_button_tag t("analytics.filters.submit"), type: :submit, name: nil, variant: :secondary %>
      <%= workspace_link_button t("analytics.filters.clear"), request.path, variant: :ghost if filtered %>
    </div>
  </div>

  <p class="analytics-filters__window">
    <span class="analytics-filters__window-current"><%= @filters.window.label %></span>
    <% if @filters.compare? %>
      <span><%= t("analytics.filters.compared_with", window: @filters.previous_window.label) %></span>
    <% end %>
  </p>

  <% @filters.adjustments.each do |adjustment| %>
    <div class="workspace-callout workspace-callout--warning analytics-filters__notice" role="status">
      <%= workspace_icon(:warning) %>
      <p><%= t("analytics.filters.adjustments.#{adjustment}") %></p>
    </div>
  <% end %>
<% end %>
