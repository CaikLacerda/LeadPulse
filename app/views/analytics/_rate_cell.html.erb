<%# Taxa ou duração numa tabela: valor com ⓘ quando a amostra é baixa e o n abaixo. %>
<span class="analytics-rate-cell">
  <span class="analytics-rate-cell__value"><%= analytics_metric_value(metric) %><% if metric.available? && metric.low_sample? %> <%= analytics_low_sample_flag(sample: metric.sample) %><% end %></span>
  <span class="analytics-rate-cell__sample"><%= t("analytics.metric.sample", count: analytics_count(metric.sample)) %></span>
</span>
