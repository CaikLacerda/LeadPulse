<% summary = @page[:summary] %>
<% table = @page[:table] %>

<%= render layout: "analytics/frame" do %>
  <% if summary.failed? %>
    <%= analytics_section_error %>
  <% elsif summary.data[:metrics][:batches].current.value.zero? %>
    <%= render "analytics/empty", message: t("analytics.empty_batches") %>
  <% else %>
    <% metrics = summary.data[:metrics] %>
    <%= render "analytics/kpis", metrics: metrics, page: :batches %>
    <% if metrics[:median_processing].current.sample.positive? %>
      <%# Distribuição + resumo lado a lado no desktop; a tabela analítica vem logo abaixo. %>
      <div class="analytics-split">
        <%= render "analytics/chart",
            key: "processing",
            title: t("analytics.sections.processing_distribution"),
            **analytics_processing_histogram(summary.data[:processing_bins], median: metrics[:median_processing].current, p90: metrics[:p90_processing].current) %>
        <%= render "analytics/processing_summary", metrics: metrics, processing: summary.data[:processing], bins: summary.data[:processing_bins] %>
      </div>
    <% end %>
    <%= render "analytics/batches_table", section: table %>
  <% end %>
<% end %>
