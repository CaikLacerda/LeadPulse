<%# Moldura de um gráfico. A tabela de dados é sempre renderizada: é a versão acessível e a que
    aparece sem JavaScript, pelo botão "Tabela" ou se o gráfico falhar. O ECharts desenha por cima.
    locals: key, title, head, rows, chart (opcional), controls (opcional), note (opcional), note_3d (opcional),
    section (opcional). chart[:scale] liga a legenda da escala sequencial (mapa de calor). %>
<% section = local_assigns[:section] %>
<% chart = local_assigns[:chart] unless section&.failed? %>
<% note = local_assigns[:note] %>
<% actions = [local_assigns[:controls]] %>
<% if chart %>
  <% actions << capture do %>
    <button type="button" class="analytics-chart__toggle" aria-pressed="false" aria-label="<%= t("analytics.chart.table_aria") %>"
            data-analytics-chart-target="toggle" data-action="analytics-chart#toggleTable">
      <i class="fa-solid fa-table-list" aria-hidden="true"></i><span><%= t("analytics.chart.table") %></span>
    </button>
  <% end %>
<% end %>

<%= portlet_form(title, actions.compact,
      class: "analytics-chart",
      id: "analytics-chart-#{key}",
      body_class: "analytics-chart__body",
      data: (chart ? { controller: "analytics-chart", analytics_chart_kind_value: chart[:kind], analytics_chart_data_value: chart[:data].to_json } : {})) do %>
  <% if section&.failed? %>
    <%= analytics_section_error %>
  <% else %>
    <% if chart %>
      <div class="analytics-chart__visual">
        <div class="analytics-chart__canvas" data-analytics-chart-target="canvas" role="img"
             aria-label="<%= chart[:summary] %>" style="--analytics-chart-height: <%= chart[:height].to_i %>px"></div>
        <% if (scale = chart[:scale]) %>
          <%# Legenda no padrão do design system (não a do ECharts). Só visual: a tabela traz os números. %>
          <div class="analytics-scale" aria-hidden="true">
            <span class="analytics-scale__caption analytics-scale__caption--volume"><%= t("analytics.scale.volume") %></span>
            <span class="analytics-scale__caption analytics-scale__caption--rate"><%= t("analytics.scale.rate") %></span>
            <span class="analytics-scale__range">
              <span class="analytics-scale__value analytics-scale__value--volume">0</span>
              <span class="analytics-scale__value analytics-scale__value--rate">0%</span>
              <span class="analytics-scale__ramp"></span>
              <span class="analytics-scale__value analytics-scale__value--volume"><%= scale[:volume_max] %></span>
              <span class="analytics-scale__value analytics-scale__value--rate">100%</span>
            </span>
            <span class="analytics-scale__low"><span class="analytics-scale__swatch"></span><%= t("analytics.scale.low_sample") %></span>
          </div>
        <% end %>
      </div>
      <p class="analytics-chart__unavailable" role="status"><%= t("analytics.chart.unavailable") %></p>
    <% end %>

    <div class="workspace-table-wrap analytics-chart__table">
      <table class="workspace-table">
        <caption class="sr-only"><%= title %></caption>
        <thead>
          <tr>
            <% head.each_with_index do |label, index| %>
              <th scope="col" class="<%= 'is-numeric' unless index.zero? %>"><%= label %></th>
            <% end %>
          </tr>
        </thead>
        <tbody>
          <% rows.each do |cells| %>
            <tr>
              <% cells.each_with_index do |cell, index| %>
                <% if index.zero? %>
                  <th scope="row"><%= cell %></th>
                <% else %>
                  <td class="is-numeric"><%= cell %></td>
                <% end %>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <% if note.present? %>
      <p class="analytics-chart__note" data-analytics-chart-target="note"><%= note %></p>
    <% end %>
    <% if local_assigns[:note_3d].present? %>
      <p class="analytics-chart__note analytics-chart__note--3d" hidden data-analytics-chart-target="note3d">
        <span class="analytics-chart__badge"><i class="fa-solid fa-cube" aria-hidden="true"></i><%= t("analytics.view_switch.badge") %></span>
        <span><%= local_assigns[:note_3d] %></span>
      </p>
    <% end %>
  <% end %>
<% end %>
