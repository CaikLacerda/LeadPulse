<%# Alterna a medida do mapa de calor (precisa de JavaScript; a tabela traz as duas) e, no desktop
    com WebGL, a visão 3D das mesmas células. O botão 3D nasce oculto e só aparece se for possível. %>
<div class="analytics-chart__modes">
  <div class="analytics-segmented" role="group" aria-label="<%= t("analytics.heatmap_modes.aria") %>">
    <% { "volume" => t("analytics.heatmap_modes.volume"), "rate" => t("analytics.heatmap_modes.rate") }.each do |mode, label| %>
      <button type="button" class="analytics-segmented__item" aria-pressed="<%= mode == "volume" %>"
              data-analytics-chart-target="mode" data-action="analytics-chart#setMode" data-analytics-chart-mode-param="<%= mode %>">
        <%= label %>
      </button>
    <% end %>
  </div>
  <button type="button" class="analytics-segmented analytics-segmented__item analytics-chart__view" aria-pressed="false" hidden
          aria-label="<%= t("analytics.heatmap_modes.view_3d_aria") %>" data-analytics-chart-target="view" data-action="analytics-chart#toggleView">
    <i class="fa-solid fa-cube" aria-hidden="true"></i><span>3D</span>
  </button>
  <button type="button" class="analytics-chart__reset" hidden data-analytics-chart-target="reset" data-action="analytics-chart#resetCamera">
    <i class="fa-solid fa-rotate-left" aria-hidden="true"></i><span><%= t("analytics.heatmap_modes.reset_camera") %></span>
  </button>
</div>
