<% if current_user %>
  <% integration_rows = [
    ['Empresa', @integration_flags[:company], current_user.validation_account_id.presence || 'Provisionar conta', company_platform_settings_path],
    ['Twilio', @integration_flags[:twilio], @integration_flags[:twilio] ? 'Conta e números prontos' : 'Conectar conta e números', twilio_platform_settings_path],
    ['OpenAI', @integration_flags[:openai], @integration_flags[:openai] ? 'Chave configurada' : 'Definir chave da conta', openai_platform_settings_path],
    ['Token', @integration_flags[:api_token], @integration_flags[:api_token] ? 'Token ativo' : 'Gerar novo token', api_token_platform_settings_path]
  ] %>
  <% attention_items = [] %>
  <% attention_items << ['Configurar empresa', 'A conta ainda não foi provisionada na API.', company_platform_settings_path] unless @integration_flags[:company] %>
  <% attention_items << ['Conectar Twilio', 'As chamadas ainda não podem sair desta conta.', twilio_platform_settings_path] unless @integration_flags[:twilio] %>
  <% attention_items << ['Configurar OpenAI', 'A IA conversacional ainda não está pronta para operar.', openai_platform_settings_path] unless @integration_flags[:openai] %>
  <% attention_items << ['Gerar token da API', 'A integração ainda não tem token ativo para autenticação.', api_token_platform_settings_path] unless @integration_flags[:api_token] %>
  <% if @dashboard_insights[:pending_batches].positive? %>
    <% attention_items << ['Iniciar lotes pendentes', "#{@dashboard_insights[:pending_batches]} lote(s) aguardando início.", supplier_imports_path(status: 'pendente')] %>
  <% end %>
  <% if @dashboard_insights[:processing_batches].positive? %>
    <% attention_items << ['Acompanhar processamento', "#{@dashboard_insights[:processing_batches]} lote(s) em andamento.", supplier_imports_path(status: 'processando')] %>
  <% end %>
  <% if @dashboard_insights[:ready_exports].positive? %>
    <% attention_items << ['Exportar resultados', "#{@dashboard_insights[:ready_exports]} lote(s) já voltaram com resultado.", supplier_imports_path(status: 'concluido')] %>
  <% end %>
  <% account_ready_count = integration_rows.count { |row| row[1] } %>
  <% process_steps = [
    ['Conta', "#{account_ready_count}/4 integrações prontas", account_ready_count == 4 ? 'Pronta para operar' : 'Concluir configuração', company_platform_settings_path, account_ready_count == 4],
    ['Busca', "#{@dashboard_insights[:total_searches]} busca(s) salvas", 'Abrir ou revisar fornecedores encontrados', supplier_discovery_searches_path, @dashboard_insights[:total_searches].positive?],
    ['Validação', "#{@dashboard_insights[:processing_batches]} em andamento · #{@dashboard_insights[:pending_batches]} pendente(s)", 'Acompanhar lotes e retornos da API', supplier_imports_path, @dashboard_insights[:total_batches].positive?],
    ['Exportação', "#{@dashboard_insights[:ready_exports]} pronto(s)", 'Baixar resultados para ação comercial', supplier_imports_path(status: 'concluido'), @dashboard_insights[:ready_exports].positive?]
  ] %>

  <%= workspace_page do %>
    <%= workspace_page_header(
      kicker: t('home.workspace.kicker'),
      title: t('home.workspace.title'),
      description: t('home.workspace.welcome_html', name: @welcome_contact_name).html_safe,
      actions_data: { tutorial_id: 'home-actions' }
    ) do %>
      <%= link_to t('home.workspace.new_search'), supplier_discovery_searches_path,
          class: workspace_button_class(:secondary) %>
      <%= link_to t('home.workspace.new_batch'), supplier_imports_path(open_import_modal: '1'),
          class: workspace_button_class(:primary) %>
      <%= link_to t('home.workspace.settings'), company_platform_settings_path,
          class: workspace_button_class(:secondary) %>
    <% end %>

    <div class="mb-6 grid gap-4 md:grid-cols-2 xl:grid-cols-4" data-tutorial-id="home-metrics">
      <%= workspace_metric_card(label: 'Buscas salvas', value: @dashboard_insights[:total_searches], description: 'Histórico de descoberta já registrado.') %>
      <%= workspace_metric_card(label: 'Lotes importados', value: @dashboard_insights[:total_batches], description: 'Bases já levadas para validação.') %>
      <%= workspace_metric_card(label: 'Pendentes', value: @dashboard_insights[:pending_batches], description: 'Lotes aguardando início.') %>
      <%= workspace_metric_card(label: 'Prontos para exportar', value: @dashboard_insights[:ready_exports], description: 'Resultados já concluídos.') %>
    </div>

    <%= portlet_form('Visão geral do processo', content_tag(:span, "Conta #{account_ready_count}/4 pronta", class: 'workspace-portlet-meta'), data: { tutorial_id: 'home-process' }, body_class: 'workspace-portlet-body--flush') do %>
      <div class="grid gap-px bg-slate-200 lg:grid-cols-4">
        <% process_steps.each do |title, metric, description, path, ready| %>
          <%= link_to path, class: 'block bg-white p-5 transition hover:bg-blue-50/60' do %>
            <div class="flex items-center justify-between gap-3">
              <p class="text-sm font-black text-slate-950"><%= title %></p>
              <span class="<%= ready ? 'workspace-status workspace-status--success' : 'workspace-status workspace-status--warning' %>">
                <%= ready ? 'Ativo' : 'Pendente' %>
              </span>
            </div>
            <p class="mt-4 text-2xl font-black tracking-[-0.03em] text-slate-950"><%= metric %></p>
            <p class="mt-2 text-sm leading-6 text-slate-500"><%= description %></p>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <div class="mt-6 grid gap-6 xl:grid-cols-[1.2fr_0.8fr]">
      <%= portlet_form(t('home.workspace.latest_batches'), link_to(t('home.workspace.open_validation'), supplier_imports_path, class: 'text-xs font-semibold text-slate-500 transition hover:text-blue-700'), data: { tutorial_id: 'home-batches' }, body_class: 'workspace-portlet-body--flush') do %>
          <% if @recent_imports.any? %>
            <div class="overflow-x-auto">
              <table class="workspace-table">
                <thead>
                  <tr>
                    <th>Lote</th>
                    <th>Tipo</th>
                    <th>Registros</th>
                    <th>Status</th>
                    <th>Data</th>
                    <th>Ação</th>
                  </tr>
                </thead>
                <tbody>
                  <% @recent_imports.each do |supplier_import| %>
                    <tr>
                      <td><%= workspace_code_tag(supplier_import.display_code) %></td>
                      <td class="font-medium text-slate-700"><%= supplier_import.workflow_kind_label %></td>
                      <td class="font-medium text-slate-700"><%= supplier_import.total_rows %></td>
                      <td><%= workspace_status_tag(supplier_import.status) %></td>
                      <td><%= workspace_datetime_cell(supplier_import.created_at) %></td>
                      <td class="whitespace-nowrap">
                        <%= link_to t('shared.empty_state.open'), supplier_imports_path(q: supplier_import.display_code), class: 'text-[13px] font-semibold text-blue-700 transition hover:text-blue-900' %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <div class="px-4 py-10 text-sm text-slate-500">
              <%= t('home.workspace.empty_batches') %>
            </div>
          <% end %>
      <% end %>

      <div class="space-y-6">
        <%= portlet_form('Pontos de atenção', content_tag(:span, "#{attention_items.size} item#{'s' if attention_items.size != 1}", class: 'workspace-portlet-meta'), data: { tutorial_id: 'home-integrations' }, body_class: 'workspace-portlet-body--flush') do %>
          <% if attention_items.any? %>
            <div class="divide-y divide-slate-200">
              <% attention_items.each do |title, body, path| %>
                <div class="flex items-start justify-between gap-4 px-4 py-4">
                  <div>
                    <p class="text-sm font-semibold text-slate-900"><%= title %></p>
                    <p class="mt-1 text-sm leading-6 text-slate-500"><%= body %></p>
                  </div>
                  <%= link_to 'Abrir', path, class: 'whitespace-nowrap text-[13px] font-semibold text-blue-700 transition hover:text-blue-900' %>
                </div>
              <% end %>
            </div>
          <% else %>
            <div class="px-4 py-10 text-sm text-slate-500">
              Nada crítico agora. A conta está pronta e sem fila parada neste momento.
            </div>
          <% end %>
        <% end %>

        <%= portlet_form('Integrações', content_tag(:span, "#{integration_rows.count { |row| row[1] }}/4 prontas", class: 'workspace-portlet-meta'), body_class: 'workspace-portlet-body--flush') do %>
          <div class="divide-y divide-slate-200">
            <% integration_rows.each do |label, ready, detail, path| %>
              <div class="flex items-start justify-between gap-4 px-4 py-4">
                <div>
                  <div class="flex items-center gap-2">
                    <p class="text-sm font-semibold text-slate-900"><%= label %></p>
                    <span class="<%= ready ? 'workspace-status workspace-status--success' : 'workspace-status workspace-status--warning' %>">
                      <%= ready ? 'Pronto' : 'Pendente' %>
                    </span>
                  </div>
                  <p class="mt-1 text-sm leading-6 text-slate-500"><%= detail %></p>
                </div>
                <%= link_to 'Abrir', path, class: 'whitespace-nowrap text-[13px] font-semibold text-blue-700 transition hover:text-blue-900' %>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>

    <div class="mt-6 grid gap-6 xl:grid-cols-[0.92fr_1.08fr]">
      <%= portlet_form(t('home.workspace.recent_searches'), link_to(t('home.workspace.open_search'), supplier_discovery_searches_path, class: 'text-xs font-semibold text-slate-500 transition hover:text-blue-700'), body_class: 'workspace-portlet-body--flush') do %>
          <% if @recent_searches.any? %>
            <div class="overflow-x-auto">
              <table class="workspace-table">
                <thead>
                  <tr>
                    <th>Busca</th>
                    <th>Segmento</th>
                    <th>Região</th>
                    <th>Importáveis</th>
                  </tr>
                </thead>
                <tbody>
                  <% @recent_searches.each do |search| %>
                    <tr>
                      <td><%= workspace_code_tag(search.display_code) %></td>
                      <td class="font-medium text-slate-700"><%= search.segment_name %></td>
                      <td class="font-medium text-slate-700"><%= search.region.presence || 'Sem filtro' %></td>
                      <td class="font-medium text-slate-700"><%= search.valid_supplier_candidates.size %></td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <div class="px-4 py-10 text-sm text-slate-500">
              <%= t('home.workspace.empty_searches') %>
            </div>
          <% end %>
      <% end %>

      <%= portlet_form('Conta', content_tag(:span, current_user.validation_account_id.presence || 'não provisionada', class: 'workspace-portlet-meta'), body_class: 'workspace-portlet-body--flush') do %>
        <div class="grid gap-px bg-slate-200">
          <%= workspace_definition_row(label: 'Empresa', value: current_user.validation_company_name_value) %>
          <%= workspace_definition_row(label: 'Nome falado pela IA', value: current_user.validation_spoken_company_name_value) %>
          <%= workspace_definition_row(label: 'Responsável', value: "#{@welcome_contact_name} · #{current_user.validation_owner_email_value}") %>
          <%= workspace_definition_row(label: 'Registros processados', value: number_with_delimiter(@dashboard_insights[:total_records])) %>
        </div>
      <% end %>
    </div>

    <% home_map_points = supplier_discovery_map_points(@recent_location_searches, limit: 80) %>
    <div class="mt-6">
      <%= render 'shared/supplier_location_map',
          points: home_map_points,
          title: 'Mapa de fornecedores encontrados',
          meta: supplier_location_map_meta(home_map_points),
          empty_message: 'As próximas buscas com cidade, UF ou coordenada vão aparecer no mapa do Brasil.' %>
    </div>
  <% end %>

  <%= render 'shared/workspace_tutorial', steps: workspace_tutorial_steps(:home) %>
<% else %>
  <%= render 'public_landing' %>
<% end %>
