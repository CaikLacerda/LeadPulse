<% if current_user %>
  <% integration_rows = [
    ['Conta na API', @integration_flags[:company], current_user.validation_account_id.present? ? "ID #{current_user.validation_account_id}" : 'Não provisionada', company_platform_settings_path],
    ['Twilio', @integration_flags[:twilio], @integration_flags[:twilio] ? 'Conta e números' : 'Conectar conta e números', twilio_platform_settings_path],
    ['OpenAI', @integration_flags[:openai], @integration_flags[:openai] ? 'Chave configurada' : 'Definir chave da conta', openai_platform_settings_path],
    ['Token da API', @integration_flags[:api_token], @integration_flags[:api_token] ? 'Token ativo' : 'Gerar token de integração', api_token_platform_settings_path]
  ] %>
  <% attention_items = [] %>
  <% if current_user.can_manage_settings? %>
    <% attention_items << [:warning, 'Configurar empresa', 'A conta ainda não foi provisionada na API.', company_platform_settings_path] unless @integration_flags[:company] %>
    <% attention_items << [:warning, 'Conectar Twilio', 'As chamadas ainda não podem sair desta conta.', twilio_platform_settings_path] unless @integration_flags[:twilio] %>
    <% attention_items << [:warning, 'Configurar OpenAI', 'A IA conversacional ainda não está pronta.', openai_platform_settings_path] unless @integration_flags[:openai] %>
    <% attention_items << [:warning, 'Gerar token da API', 'A integração não tem token ativo.', api_token_platform_settings_path] unless @integration_flags[:api_token] %>
  <% end %>
  <% if @dashboard_insights[:error_batches].positive? %>
    <% attention_items << [:danger, 'Lotes com erro', "#{pluralize(@dashboard_insights[:error_batches], 'lote precisa', plural: 'lotes precisam')} de revisão.", supplier_imports_path(status: 'erro')] %>
  <% end %>
  <% if @dashboard_insights[:pending_batches].positive? && current_user.can_start_validation? %>
    <% attention_items << [:neutral, 'Iniciar lotes pendentes', "#{pluralize(@dashboard_insights[:pending_batches], 'lote aguardando', plural: 'lotes aguardando')} início.", supplier_imports_path(status: 'pendente')] %>
  <% end %>
  <% if @dashboard_insights[:processing_batches].positive? && current_user.can_start_validation? %>
    <% attention_items << [:info, 'Acompanhar processamento', "#{pluralize(@dashboard_insights[:processing_batches], 'lote', plural: 'lotes')} em andamento.", supplier_imports_path(status: 'processando')] %>
  <% end %>
  <% if @dashboard_insights[:ready_exports].positive? && current_user.can_export_data? %>
    <% attention_items << [:success, 'Exportar resultados', "#{pluralize(@dashboard_insights[:ready_exports], 'lote', plural: 'lotes')} com resultado disponível.", supplier_imports_path(status: 'concluido')] %>
  <% end %>
  <% if @dashboard_insights[:commercial_pending].positive? && current_user.can_start_validation? %>
    <% attention_items << [:neutral, 'Iniciar retornos comerciais', "#{pluralize(@dashboard_insights[:commercial_pending], 'fornecedor aguardando', plural: 'fornecedores aguardando')} coleta.", commercial_opportunities_path(status: 'pendente')] %>
  <% end %>
  <% attention_dot = { warning: 'bg-warning-dot', danger: 'bg-danger-dot', info: 'bg-info-dot', success: 'bg-success-dot', neutral: 'bg-neutral-dot' } %>
  <% period_records = @daily_imports.sum { |day| day[:records] } %>
  <% period_batches = @daily_imports.sum { |day| day[:batches] } %>

  <%= workspace_page do %>
    <%= workspace_page_header(
      title: t('home.workspace.title'),
      description: t('home.workspace.welcome_html', name: @welcome_contact_name.to_s.split.first.presence || @welcome_contact_name),
      actions_data: { tutorial_id: 'home-actions' }
    ) do %>
      <% if current_user.can_import_data? %>
        <%= link_to supplier_discovery_searches_path, class: workspace_button_class(:secondary) do %>
          <%= workspace_icon(:search) %><span><%= t('home.workspace.new_search') %></span>
        <% end %>
        <%= link_to supplier_imports_path(open_import_modal: '1'), class: workspace_button_class(:primary) do %>
          <%= workspace_icon(:plus) %><span><%= t('home.workspace.new_batch') %></span>
        <% end %>
      <% end %>
    <% end %>

    <%= workspace_metrics(classes: 'mb-6', data: { tutorial_id: 'home-metrics' }) do %>
      <%= workspace_metric_card(label: 'Em processamento', value: number_with_delimiter(@dashboard_insights[:processing_batches]), description: 'Chamadas em andamento', path: supplier_imports_path(status: 'processando')) %>
      <%= workspace_metric_card(label: 'Aguardando início', value: number_with_delimiter(@dashboard_insights[:pending_batches]), description: 'Importados, não iniciados', path: supplier_imports_path(status: 'pendente')) %>
      <%= workspace_metric_card(label: 'Concluídos', value: number_with_delimiter(@dashboard_insights[:completed_batches]), description: "#{number_with_delimiter(@dashboard_insights[:ready_exports])} prontos para exportar", path: supplier_imports_path(status: 'concluido')) %>
      <%= workspace_metric_card(label: 'Com erro', value: number_with_delimiter(@dashboard_insights[:error_batches]), value_class: ('text-danger-fg' if @dashboard_insights[:error_batches].positive?), description: 'Precisam de revisão', path: supplier_imports_path(status: 'erro')) %>
      <%= workspace_metric_card(label: 'Registros processados', value: number_with_delimiter(@dashboard_insights[:total_records]), description: "Em #{pluralize(@dashboard_insights[:total_batches], 'lote', plural: 'lotes')}") %>
    <% end %>

    <div class="grid gap-6 xl:grid-cols-[minmax(0,1.65fr)_minmax(0,1fr)]">
      <%= portlet_form('Registros importados', content_tag(:span, "Últimos 30 dias · #{pluralize(period_records, 'registro', plural: 'registros')} em #{pluralize(period_batches, 'lote', plural: 'lotes')}", class: 'workspace-portlet-meta'), class: 'flex flex-col', body_class: 'workspace-portlet-body--flush flex flex-1 flex-col') do %>
        <%= render 'daily_imports_chart', series: @daily_imports %>
      <% end %>

      <%= portlet_form('Requer atenção', [], count: attention_items.size, body_class: 'workspace-portlet-body--flush', data: { tutorial_id: 'home-integrations' }) do %>
        <% if attention_items.any? %>
          <div class="workspace-list">
            <% attention_items.each do |tone, title, body, path| %>
              <%= link_to path, class: 'workspace-list__item' do %>
                <span class="flex min-w-0 items-start gap-3">
                  <span class="mt-[0.4375rem] h-1.5 w-1.5 flex-none rounded-full <%= attention_dot.fetch(tone) %>" aria-hidden="true"></span>
                  <span class="min-w-0">
                    <span class="workspace-list__title block"><%= title %></span>
                    <span class="workspace-list__meta block"><%= body %></span>
                  </span>
                </span>
                <i class="workspace-list__chevron fa-solid fa-chevron-right" aria-hidden="true"></i>
              <% end %>
            <% end %>
          </div>
        <% else %>
          <%= workspace_empty_state(message: 'Nada pendente agora.', hint: 'Lotes parados, erros e resultados prontos aparecem aqui.') %>
        <% end %>
      <% end %>
    </div>

    <div class="mt-6 grid gap-6 xl:grid-cols-[minmax(0,1.65fr)_minmax(0,1fr)]">
      <%= portlet_form(t('home.workspace.latest_batches'), link_to(t('home.workspace.open_validation'), supplier_imports_path, class: 'workspace-portlet-link'), body_class: 'workspace-portlet-body--flush', data: { tutorial_id: 'home-batches' }) do %>
        <% if @recent_imports.any? %>
          <div class="workspace-table-wrap">
            <table class="workspace-table">
              <thead>
                <tr>
                  <th scope="col">Lote</th>
                  <th scope="col">Tipo</th>
                  <th scope="col" class="is-numeric">Registros</th>
                  <th scope="col">Status</th>
                  <th scope="col">Importado em</th>
                </tr>
              </thead>
              <tbody>
                <% @recent_imports.each do |supplier_import| %>
                  <tr>
                    <td><%= workspace_code_tag(supplier_import.display_code, current_user.can_view_evidence? ? supplier_import_path(supplier_import) : supplier_imports_path(q: supplier_import.display_code)) %></td>
                    <td><%= supplier_import.workflow_kind_label %></td>
                    <td class="is-numeric"><%= number_with_delimiter(supplier_import.total_rows) %></td>
                    <td><%= workspace_status_tag(supplier_import.status) %></td>
                    <td><%= workspace_datetime_cell(supplier_import.created_at) %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <%= workspace_empty_state(message: t('home.workspace.empty_batches'), hint: 'Os lotes importados aparecem aqui com o status da validação.') do %>
            <% if current_user.can_import_data? %>
              <%= workspace_link_button supplier_imports_path(open_import_modal: '1'), variant: :primary, size: :sm do %>
                <%= workspace_icon(:plus) %><span><%= t('home.workspace.new_batch') %></span>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>

      <%= portlet_form('Conta e integrações', content_tag(:span, "#{integration_rows.count { |row| row[1] }} de #{integration_rows.size} configuradas", class: 'workspace-portlet-meta'), body_class: 'workspace-portlet-body--flush') do %>
        <div class="workspace-list">
          <% integration_rows.each do |label, ready, detail, path| %>
            <% row_content = capture do %>
              <span class="flex min-w-0 items-baseline gap-2">
                <span class="workspace-list__title flex-none"><%= label %></span>
                <span class="workspace-list__meta truncate"><%= detail %></span>
              </span>
              <%= status_badge(ready ? 'Configurado' : 'Pendente', tone: ready ? :success : :warning) %>
            <% end %>
            <% if current_user.can_manage_settings? %>
              <%= link_to row_content, path, class: 'workspace-list__item' %>
            <% else %>
              <div class="workspace-list__item"><%= row_content %></div>
            <% end %>
          <% end %>
        </div>

        <dl class="grid grid-cols-2 gap-x-6 gap-y-3 border-t border-line px-5 py-4 workspace-kv">
          <div>
            <dt>Empresa</dt>
            <dd><%= current_user.validation_company_name_value %></dd>
          </div>
          <div>
            <dt>Nome falado pela IA</dt>
            <dd><%= current_user.validation_spoken_company_name_value %></dd>
          </div>
          <div class="col-span-full">
            <dt>Responsável</dt>
            <dd><%= @welcome_contact_name %> · <%= current_user.validation_owner_email_value %></dd>
          </div>
        </dl>
      <% end %>
    </div>

    <% home_map_points = supplier_discovery_map_points(@recent_location_searches, limit: 80) %>
    <div class="mt-6 grid gap-6 xl:grid-cols-[minmax(0,1fr)_minmax(0,1.65fr)]">
      <%= portlet_form(t('home.workspace.recent_searches'), link_to(t('home.workspace.open_search'), supplier_discovery_searches_path, class: 'workspace-portlet-link'), body_class: 'workspace-portlet-body--flush') do %>
        <% if @recent_searches.any? %>
          <div class="workspace-table-wrap">
            <table class="workspace-table">
              <thead>
                <tr>
                  <th scope="col">Segmento</th>
                  <th scope="col">Região</th>
                  <th scope="col" class="is-numeric">Importáveis</th>
                </tr>
              </thead>
              <tbody>
                <% @recent_searches.each do |search| %>
                  <tr>
                    <td>
                      <span class="workspace-table__primary"><%= search.segment_name %></span>
                      <span class="workspace-table__secondary"><%= workspace_code_tag(search.display_code) %></span>
                    </td>
                    <td><%= search.region.presence || content_tag(:span, 'Sem filtro', class: 'workspace-table__muted') %></td>
                    <td class="is-numeric"><%= search.valid_supplier_candidates.size %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <%= workspace_empty_state(message: t('home.workspace.empty_searches'), hint: 'Pesquise fornecedores por segmento e região antes de validar.') %>
        <% end %>
      <% end %>

      <%= render 'shared/supplier_location_map',
          points: home_map_points,
          title: 'Localização dos fornecedores',
          meta: supplier_location_map_meta(home_map_points),
          empty_message: 'Buscas com cidade, UF ou coordenadas aparecem no mapa.' %>
    </div>
  <% end %>

  <%= render 'shared/workspace_tutorial', steps: workspace_tutorial_steps(:home) %>
<% else %>
  <%= render 'public_landing' %>
<% end %>
