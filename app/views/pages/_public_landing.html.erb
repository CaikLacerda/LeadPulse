<%# Landing pública. As imagens são telas reais do LeadPulse com dados fictícios de demonstração. %>
<% landing_description = 'O LeadPulse encontra fornecedores no seu recorte, valida por voz com IA e entrega resultados com transcrição, revisão humana e exportação.' %>
<% content_for :title, 'LeadPulse · Prospecção e validação de fornecedores por voz com IA' %>
<% content_for :head do %>
  <meta name="description" content="<%= landing_description %>">
  <link rel="canonical" href="<%= root_url %>">
  <meta property="og:type" content="website">
  <meta property="og:locale" content="pt_BR">
  <meta property="og:site_name" content="LeadPulse">
  <meta property="og:title" content="LeadPulse · Venda para empresas que já fazem sentido">
  <meta property="og:description" content="<%= landing_description %>">
  <meta property="og:url" content="<%= root_url %>">
  <meta property="og:image" content="<%= image_url('landing/og-leadpulse.jpg') %>">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="Tela de Analytics do LeadPulse">
  <meta name="twitter:card" content="summary_large_image">
<% end %>

<% steps = [
  ['01', 'Encontre', 'Busque fornecedores por segmento e região ou importe a sua planilha.'],
  ['02', 'Ligue', 'A IA liga para cada contato, avisa que a chamada é automatizada e segue o roteiro.'],
  ['03', 'Valide', 'Cada conversa vira um resultado, como fornecedor qualificado, não fornece o segmento ou inconclusiva.'],
  ['04', 'Analise', 'Revise transcrições, corrija resultados e acompanhe as taxas no Analytics.']
] %>

<% product_sections = [
  {
    label: 'Busca de fornecedores',
    title: 'Monte a lista pelo segmento e pela região.',
    body: 'Cada busca devolve fornecedores com telefone e cidade, prontos para virar um lote de validação.',
    points: ['Busca por segmento e região', 'Importação de planilha própria', 'Mapa com a localização dos fornecedores'],
    image: 'produto-busca', size: [1200, 450],
    alt: 'Tela Busca de fornecedores do LeadPulse com buscas concluídas por segmento e região.'
  },
  {
    label: 'Chamadas com IA',
    title: 'Uma conversa curta, com roteiro e registro.',
    body: 'A assistente se apresenta, avisa que a chamada é automatizada e confirma contato, segmento e interesse comercial.',
    points: ['Transcrição na ordem real da conversa', 'Recusa de contato registrada (LGPD)', 'Retorno comercial com telefone e horário'],
    image: 'produto-chamada', size: [1200, 582],
    alt: 'Conversa de uma chamada na Auditoria do LeadPulse, com as perguntas da IA, as respostas do fornecedor e o painel de revisão humana.'
  },
  {
    label: 'Auditoria e resultados',
    title: 'Resultados que o time consegue conferir.',
    body: 'Cada lote mostra o resultado por empresa, a tentativa e a duração da chamada. Quem revisa corrige e exporta.',
    points: ['Revisão humana com observação', 'Relatório LGPD por lote', 'Exportação dos resultados'],
    image: 'produto-lote', size: [1200, 529],
    alt: 'Registros de um lote de validação no LeadPulse com o resultado de cada empresa e as tentativas de chamada.'
  }
] %>

<% features = [
  ['fa-magnifying-glass', 'Busca de fornecedores', 'Por segmento e região, com mapa.'],
  ['fa-file-arrow-up', 'Importação de planilhas', 'Sua própria base vira um lote.'],
  ['fa-phone-volume', 'Chamadas por voz com IA', 'Twilio e OpenAI Realtime da sua conta.'],
  ['fa-handshake', 'Retornos comerciais', 'Quem aceitou contato, com horário preferido.'],
  ['fa-list-check', 'Auditoria de chamadas', 'Transcrição, resultado e revisão humana.'],
  ['fa-chart-line', 'Analytics', 'Atendimento, confirmação e duração por período.'],
  ['fa-shield-halved', 'LGPD e privacidade', 'Base legal, aviso falado, retenção e solicitações.'],
  ['fa-user-group', 'Equipe e papéis', 'Administrador, gestor, operador, auditor e visualizador.'],
  ['fa-code', 'API para desenvolvedores', 'Token de integração e documentação.']
] %>

<% faq_items = [
  ['O LeadPulse substitui meu CRM?', 'Não. Ele prepara e valida a base antes da abordagem. Depois você exporta ou usa os resultados no seu fluxo comercial.'],
  ['Preciso ter uma base pronta?', 'Não. Você pode começar por busca de segmento e região ou importar uma planilha própria.'],
  ['A chamada avisa que é automatizada?', 'Sim. O fluxo de voz inclui aviso de chamada automatizada, finalidade e registro de recusa quando a pessoa não quiser continuar.'],
  ['Consigo revisar o resultado?', 'Sim. A auditoria permite revisar status, transcrição, observação e evidências antes de exportar.']
] %>

<div class="landing">
  <section id="inicio" class="landing-hero" aria-labelledby="landing-title">
    <div class="landing-container">
      <div class="landing-hero__intro">
        <div class="landing-hero__copy">
          <p class="landing-eyebrow"><span class="landing-pulse" aria-hidden="true"></span>Prospecção e validação B2B por voz</p>
          <h1 id="landing-title" class="landing-hero__title">Venda para empresas que já fazem sentido.</h1>
          <p class="landing-hero__lead">O LeadPulse encontra contatos dentro do seu recorte, confirma por voz com IA se há aderência e entrega resultados com evidências para o seu time.</p>
          <div class="landing-actions">
            <%= link_to 'Criar conta grátis', new_user_registration_path, class: workspace_button_class(:primary, nil, size: :lg) %>
            <%= link_to root_path(anchor: 'como-funciona'), class: 'landing-arrow-link' do %>
              Ver como funciona <i class="fa-solid fa-arrow-down" aria-hidden="true"></i>
            <% end %>
          </div>
        </div>

        <ul class="landing-hero__facts">
          <li><i class="fa-solid fa-check" aria-hidden="true"></i>Busca por segmento e região ou planilha própria</li>
          <li><i class="fa-solid fa-check" aria-hidden="true"></i>Chamada que se identifica como automatizada</li>
          <li><i class="fa-solid fa-check" aria-hidden="true"></i>Transcrição, revisão humana e exportação</li>
        </ul>
      </div>

      <figure class="landing-shot landing-hero__shot">
        <%= image_tag 'landing/produto-analytics-1600.webp',
              srcset: { 'landing/produto-analytics-800.webp' => '800w', 'landing/produto-analytics-1600.webp' => '1600w' },
              sizes: '(min-width: 1152px) 1088px, calc(100vw - 2rem)',
              width: 1600, height: 1173, fetchpriority: 'high',
              alt: 'Tela de Analytics do LeadPulse com registros, taxas de validação, confirmação e atendimento, duração mediana e o gráfico diário por resultado.' %>
      </figure>
      <p class="landing-shot__caption">Telas reais do LeadPulse com dados fictícios de demonstração.</p>
    </div>
  </section>

  <section id="como-funciona" class="landing-section landing-section--muted" aria-labelledby="como-funciona-title">
    <div class="landing-container">
      <div class="landing-heading">
        <p class="landing-eyebrow">Como funciona</p>
        <h2 id="como-funciona-title" class="landing-h2">Da lista ao resultado em quatro passos.</h2>
      </div>

      <ol class="landing-steps">
        <% steps.each do |number, title, body| %>
          <li class="landing-steps__item">
            <span class="landing-steps__number" aria-hidden="true"><%= number %></span>
            <h3 class="landing-steps__title"><%= title %></h3>
            <p class="landing-steps__body"><%= body %></p>
          </li>
        <% end %>
      </ol>
    </div>
  </section>

  <section id="recursos" class="landing-section" aria-labelledby="recursos-title">
    <div class="landing-container">
      <div class="landing-heading">
        <p class="landing-eyebrow">Recursos</p>
        <h2 id="recursos-title" class="landing-h2">O que o LeadPulse faz hoje.</h2>
      </div>

      <% product_sections.each_with_index do |section, index| %>
        <article class="landing-feature <%= 'landing-feature--reverse' if index.odd? %>">
          <div class="landing-feature__copy">
            <p class="landing-feature__label"><%= section[:label] %></p>
            <h3 class="landing-h3"><%= section[:title] %></h3>
            <p class="landing-feature__body"><%= section[:body] %></p>
            <ul class="landing-checks">
              <% section[:points].each do |point| %>
                <li><i class="fa-solid fa-check" aria-hidden="true"></i><%= point %></li>
              <% end %>
            </ul>
          </div>
          <figure class="landing-shot landing-feature__shot">
            <%= image_tag "landing/#{section[:image]}-1200.webp",
                  srcset: { "landing/#{section[:image]}-640.webp" => '640w', "landing/#{section[:image]}-1200.webp" => '1200w' },
                  sizes: '(min-width: 1024px) 600px, calc(100vw - 2rem)',
                  width: section[:size][0], height: section[:size][1], loading: 'lazy', decoding: 'async', alt: section[:alt] %>
          </figure>
        </article>
      <% end %>

      <ul class="landing-capabilities" aria-label="Todos os recursos">
        <% features.each do |icon, title, body| %>
          <li>
            <i class="fa-solid <%= icon %>" aria-hidden="true"></i>
            <span><strong><%= title %></strong><%= body %></span>
          </li>
        <% end %>
      </ul>
    </div>
  </section>

  <section id="planos" class="landing-section landing-section--muted" aria-labelledby="planos-title">
    <div class="landing-container landing-split">
      <div class="landing-heading">
        <p class="landing-eyebrow">Planos</p>
        <h2 id="planos-title" class="landing-h2">Planos em definição.</h2>
      </div>
      <div class="landing-plans">
        <p>Os planos comerciais ainda estão sendo definidos. Hoje, a conta é criada gratuitamente e as chamadas usam as contas Twilio e OpenAI configuradas pela sua empresa, com os custos de cada provedor.</p>
        <%= link_to 'Criar conta grátis', new_user_registration_path, class: workspace_button_class(:primary, nil, size: :lg) %>
      </div>
    </div>
  </section>

  <section id="sobre" class="landing-section" aria-labelledby="sobre-title">
    <div class="landing-container">
      <div class="landing-heading">
        <p class="landing-eyebrow">Sobre</p>
        <h2 id="sobre-title" class="landing-h2">Por que o LeadPulse existe.</h2>
      </div>
      <div class="landing-about">
        <div>
          <h3 class="landing-about__title">O problema</h3>
          <p>Listas compradas e bases antigas chegam com telefone errado e empresas fora do perfil. O time só descobre ligando, uma por uma.</p>
        </div>
        <div>
          <h3 class="landing-about__title">A solução</h3>
          <p>O LeadPulse faz a primeira ligação: confirma o contato, o segmento e o interesse antes de a equipe entrar na conversa.</p>
        </div>
        <div>
          <h3 class="landing-about__title">A abordagem</h3>
          <p>Automação com transparência: a chamada se identifica, a recusa é respeitada e cada resultado pode ser revisado por uma pessoa.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="landing-section landing-section--muted" aria-labelledby="faq-title">
    <div class="landing-container landing-split">
      <div class="landing-heading">
        <p class="landing-eyebrow">Perguntas frequentes</p>
        <h2 id="faq-title" class="landing-h2">Antes de colocar sua base para rodar.</h2>
      </div>
      <div class="landing-faq">
        <% faq_items.each do |question, answer| %>
          <details class="landing-faq__item">
            <summary><%= question %><i class="fa-solid fa-chevron-down" aria-hidden="true"></i></summary>
            <p><%= answer %></p>
          </details>
        <% end %>
      </div>
    </div>
  </section>

  <section id="contato" class="landing-cta" aria-labelledby="contato-title">
    <div class="landing-container landing-cta__inner">
      <div>
        <h2 id="contato-title" class="landing-cta__title">Comece pelo primeiro lote.</h2>
        <p class="landing-cta__body">Crie a conta, conecte as integrações e valide uma lista pequena antes de escalar.</p>
      </div>
      <div class="landing-cta__actions">
        <%= link_to 'Criar conta grátis', new_user_registration_path, class: workspace_button_class(:primary, nil, size: :lg) %>
        <%= link_to 'Entrar', new_user_session_path, class: 'landing-cta__link' %>
      </div>
      <%= render 'shared/waveform', css_class: 'landing-cta__wave' %>
    </div>
  </section>
</div>
