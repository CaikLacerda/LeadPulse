<% import_form_values = (@import_form_values || {}).symbolize_keys %>
<% import_modal_alert = @open_import_modal ? flash[:alert].presence : nil %>
<% modal_scope = 'supplier_imports.modal' %>

<div id="supplier-import-modal"
     data-import-modal-target="modal"
     class="fixed inset-0 z-[70] <%= @open_import_modal ? '' : 'hidden' %>">
  <div class="absolute inset-0 bg-slate-900/55 backdrop-blur-[2px]" data-action="click->import-modal#close"></div>

  <div class="relative flex min-h-full items-center justify-center p-3 sm:p-6">
    <div id="supplier-import-modal-panel"
         data-import-modal-target="panel modalPanel"
         tabindex="-1"
         class="workspace-modal workspace-modal--blue import-modal-panel relative flex max-h-[90vh] w-[min(94vw,72rem)] flex-col overflow-hidden">
      <div class="import-modal-header flex items-start justify-between gap-4">
        <div>
          <p class="import-modal-eyebrow"><%= t("#{modal_scope}.eyebrow") %></p>
          <h2 class="import-modal-title"><%= t("#{modal_scope}.title") %></h2>
          <p class="import-modal-description"><%= t("#{modal_scope}.description") %></p>
        </div>

        <button type="button"
                data-action="import-modal#close"
                aria-label="<%= I18n.t("#{modal_scope}.close") %>"
                class="import-modal-close">
          ✕
        </button>
      </div>

      <% if import_modal_alert.present? %>
        <div class="mt-5 border border-orange-200 bg-orange-50 px-3 py-2 text-sm font-semibold text-orange-700">
          <%= import_modal_alert %>
        </div>
      <% end %>

      <%= form_with url: create_import_supplier_imports_path, method: :post, multipart: true, local: true, class: 'import-modal-form flex min-h-0 flex-1 flex-col' do |f| %>
        <div class="import-modal-body grid min-h-0 flex-1 overflow-y-auto lg:grid-cols-[minmax(23rem,0.86fr)_minmax(0,1.14fr)] lg:items-stretch">
          <div class="import-modal-setup">
            <div>
              <p class="import-modal-step"><span>1.</span> <%= t("#{modal_scope}.type_label") %></p>
              <p class="import-modal-step-help"><%= t("#{modal_scope}.type_help") %></p>
              <div class="import-workflow-grid">
                <label class="import-workflow-option cursor-pointer">
                  <%= radio_button_tag :workflow_kind, SupplierImport::WORKFLOW_KIND_CADASTRAL, import_form_values[:workflow_kind] != SupplierImport::WORKFLOW_KIND_SUPPLIER, class: 'peer hidden', id: 'workflow_cadastral', data: { import_modal_target: 'cadastralRadio', action: 'change->import-modal#workflowChanged' } %>
                  <div id="workflow-cadastral-card"
                       data-import-modal-target="cadastralCard"
                       class="workspace-choice border-2 peer-checked:border-blue-500 peer-checked:bg-blue-50">
                    <div class="import-workflow-option__top">
                      <span class="import-workflow-option__icon"><%= workspace_icon(:building) %></span>
                      <span class="import-workflow-option__radio" aria-hidden="true"></span>
                    </div>
                    <p class="import-workflow-option__title"><%= t("#{modal_scope}.workflow.cadastral.title") %></p>
                    <p class="import-workflow-option__description"><%= t("#{modal_scope}.workflow.cadastral.description") %></p>
                  </div>
                </label>

                <label class="import-workflow-option cursor-pointer">
                  <%= radio_button_tag :workflow_kind, SupplierImport::WORKFLOW_KIND_SUPPLIER, import_form_values[:workflow_kind] == SupplierImport::WORKFLOW_KIND_SUPPLIER, class: 'peer hidden', id: 'workflow_segmento', data: { import_modal_target: 'supplierRadio', action: 'change->import-modal#workflowChanged' } %>
                  <div id="workflow-segmento-card"
                       data-import-modal-target="supplierCard"
                       class="workspace-choice border-2 peer-checked:border-orange-400 peer-checked:bg-orange-50">
                    <div class="import-workflow-option__top">
                      <span class="import-workflow-option__icon"><%= workspace_icon(:commercial) %></span>
                      <span class="import-workflow-option__radio" aria-hidden="true"></span>
                    </div>
                    <p class="import-workflow-option__title"><%= t("#{modal_scope}.workflow.supplier.title") %></p>
                    <p class="import-workflow-option__description"><%= t("#{modal_scope}.workflow.supplier.description") %></p>
                  </div>
                </label>
              </div>
            </div>

            <div class="import-modal-upload-section">
              <p class="import-modal-step"><span>2.</span> <%= t("#{modal_scope}.upload_step") %></p>
              <p class="import-modal-step-help"><%= t("#{modal_scope}.upload_step_help") %></p>
              <div id="import-dropzone"
                   data-import-modal-target="dropzone"
                   data-action="click->import-modal#pickFile keydown.enter->import-modal#pickFile keydown.space->import-modal#pickFile dragover->import-modal#dragOver dragleave->import-modal#dragLeave drop->import-modal#drop"
                   class="workspace-dropzone cursor-pointer border-2 border-dashed border-blue-300"
                   tabindex="0"
                   role="button"
                   aria-controls="importFileInput">
                <span class="import-upload-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" focusable="false"><path d="M16 16l-4-4-4 4M12 12v9M20.4 17.5A5 5 0 0 0 18 8.2 7 7 0 0 0 4.3 10.6 4.5 4.5 0 0 0 5.5 19H7" /></svg>
                </span>
                <p id="import-dropzone-label" data-import-modal-target="label" class="import-dropzone-label"><%= t("#{modal_scope}.upload.label") %></p>
                <p id="import-dropzone-helper" data-import-modal-target="helper" class="import-dropzone-helper"><%= t("#{modal_scope}.upload.cadastral_helper") %></p>

                <div class="import-selected-file hidden" data-import-modal-target="fileSelected">
                  <span class="import-selected-file__icon" aria-hidden="true">X</span>
                  <span class="import-selected-file__copy">
                    <strong data-import-modal-target="fileName"></strong>
                    <small data-import-modal-target="fileMeta"></small>
                  </span>
                  <button type="button" class="import-selected-file__remove" data-action="click->import-modal#removeFile" aria-label="Remover arquivo">✕</button>
                </div>
              </div>
            </div>
            <%= f.file_field :file, id: 'importFileInput', accept: '.csv,.xlsx,.json', class: 'sr-only', required: true, data: { import_modal_target: 'fileInput', action: 'change->import-modal#fileChanged' } %>

            <div class="import-modal-options grid gap-3 sm:grid-cols-[150px_1fr] sm:items-end">
              <div>
                <label for="file_separator" class="settings-label"><%= t("#{modal_scope}.separator") %> <span class="import-help-dot" title="Usado somente em arquivos CSV">i</span></label>
                <%= f.text_field :separator, value: ',', id: 'file_separator', class: 'settings-input', data: { import_modal_target: 'separatorInput', action: 'input->import-modal#separatorChanged change->import-modal#separatorChanged' } %>
              </div>

              <div class="import-policy-notice">
                <span class="import-policy-notice__icon">i</span>
                <span>
                <%= t("#{modal_scope}.policy_default_notice") %>
                <%= link_to t("#{modal_scope}.policy_default_link"), lgpd_platform_settings_path, class: 'font-bold text-blue-700 transition hover:text-blue-900' %>
                </span>
              </div>
            </div>
          </div>

          <div class="import-preview" data-import-modal-target="previewSection">
            <div class="import-preview__header">
              <div>
                <p class="import-preview__eyebrow"><%= t("#{modal_scope}.preview.eyebrow") %></p>
                <p class="import-preview__title"><%= t("#{modal_scope}.preview.title") %></p>
              </div>
              <p class="import-preview__meta" data-import-modal-target="previewMeta"></p>
            </div>

            <div class="import-preview__state import-preview__state--empty" data-import-modal-target="previewState"><%= t("#{modal_scope}.preview.empty") %></div>
            <div class="import-preview__summary hidden" data-import-modal-target="previewSummary"></div>

            <div class="import-preview__section hidden" data-import-modal-target="previewMetadataSection">
              <p class="import-preview__section-title"><%= t("#{modal_scope}.preview.sections.metadata") %></p>
              <div class="import-preview__chips" data-import-modal-target="previewMetadata"></div>
            </div>

            <div class="import-preview__section hidden" data-import-modal-target="previewColumnsSection">
              <p class="import-preview__section-title"><%= t("#{modal_scope}.preview.sections.columns") %></p>
              <div class="import-preview__chips" data-import-modal-target="previewColumns"></div>
            </div>

            <div class="import-preview__section hidden" data-import-modal-target="previewSamplesSection">
              <p class="import-preview__section-title"><%= t("#{modal_scope}.preview.sections.sample") %></p>
              <div class="overflow-x-auto">
                <table class="import-preview__table">
                  <thead data-import-modal-target="previewTableHead"></thead>
                  <tbody data-import-modal-target="previewTableBody"></tbody>
                </table>
              </div>
            </div>

            <div class="import-preview__section hidden" data-import-modal-target="previewInvalidsSection">
              <p class="import-preview__section-title"><%= t("#{modal_scope}.preview.sections.invalid_rows") %></p>
              <div class="import-preview__invalid-list" data-import-modal-target="previewInvalids"></div>
            </div>
          </div>
        </div>

        <div class="import-modal-footer flex flex-col gap-3 sm:flex-row sm:justify-end">
          <%= workspace_button_tag t("#{modal_scope}.cancel"),
              type: :button,
              variant: :secondary,
              data: { action: 'import-modal#close' } %>

          <%= f.submit t("#{modal_scope}.submit.cadastral"),
              id: 'importSubmit',
              data: { import_modal_target: 'submit' },
              disabled: true,
              class: workspace_submit_class(:disabled) %>
        </div>
      <% end %>
    </div>
  </div>
</div>
