<%= portlet_search(data: { tutorial_id: 'imports-filters' }) do %>
  <%= form_with url: supplier_imports_path, method: :get, local: true, class: 'workspace-filters__row' do |f| %>
    <label class="workspace-filters__search">
      <span class="sr-only"><%= t('supplier_imports.index.filters.query') %></span>
      <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
      <%= f.search_field :q, value: params[:q],
          placeholder: t('supplier_imports.index.filters.query'),
          class: 'settings-input' %>
    </label>

    <%= f.select :periodo,
        [[t('supplier_imports.index.filters.any_date'), ''], [t('supplier_imports.index.filters.last_7_days'), '7d'], [t('supplier_imports.index.filters.last_month'), '30d'], [t('supplier_imports.index.filters.last_year'), '1y']],
        { selected: params[:periodo] },
        class: 'settings-input workspace-filters__select', aria: { label: 'Período' } %>

    <%= f.select :status,
        [[t('supplier_imports.index.filters.all_statuses'), 'todos'], [local_status_label(SupplierImport::LOCAL_STATUS_PENDING), 'pendente'], [local_status_label(SupplierImport::LOCAL_STATUS_PROCESSING), 'processando'], [local_status_label(SupplierImport::LOCAL_STATUS_COMPLETED), 'concluido'], [local_status_label(SupplierImport::LOCAL_STATUS_ERROR), 'erro']],
        { selected: params[:status] },
        class: 'settings-input workspace-filters__select', aria: { label: 'Status' } %>

    <%= f.select :workflow_kind,
        [[t('supplier_imports.index.filters.all_types'), 'todos'], [t('supplier_imports.index.filters.cadastral'), SupplierImport::WORKFLOW_KIND_CADASTRAL], [t('supplier_imports.index.filters.supplier'), SupplierImport::WORKFLOW_KIND_SUPPLIER]],
        { selected: params[:workflow_kind] },
        class: 'settings-input workspace-filters__select', aria: { label: 'Tipo' } %>

    <div class="workspace-filters__actions">
      <%= workspace_button_tag t('supplier_imports.index.filters.submit'), type: :submit, variant: :secondary %>
      <% if params.slice(:q, :periodo, :status, :workflow_kind).values.any? { |value| value.present? && value != 'todos' } %>
        <%= workspace_link_button t('supplier_imports.index.filters.clear'), supplier_imports_path, variant: :ghost %>
      <% end %>
    </div>

    <p class="ml-auto text-[0.8125rem] text-fg-muted tabular-nums"><%= t('supplier_imports.index.table.count', count: @imports_total_count) %></p>
  <% end %>
<% end %>
