<%= portlet_search(data: { tutorial_id: 'search-filters' }) do %>
  <%= form_with url: supplier_discovery_searches_path, method: :get, local: true do |f| %>
    <div class="grid gap-3 xl:grid-cols-[minmax(0,1fr)_auto]">
      <%= f.text_field :q, value: params[:q],
          placeholder: t('supplier_discovery_searches.index.filters.query'),
          class: 'settings-input' %>

      <div class="flex gap-2">
        <%= workspace_link_button t('supplier_discovery_searches.index.filters.clear'), supplier_discovery_searches_path %>
        <%= workspace_button_tag t('supplier_discovery_searches.index.filters.submit'), type: :submit %>
      </div>
    </div>
  <% end %>
<% end %>
