<% content_for :title, 'Entrar · LeadPulse' %>
<% content_for :description, 'Entre no LeadPulse para buscar fornecedores, validar por voz com IA e auditar as chamadas da sua empresa.' %>

<h1 class="auth-title">Entrar</h1>
<p class="auth-description">Acesse o painel de validação da sua empresa.</p>

<%= render 'devise/shared/messages' %>

<%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: 'auth-form' }) do |f| %>
  <div class="auth-field">
    <%= f.label :email, 'E-mail corporativo', class: 'settings-label' %>
    <%= f.email_field :email, autofocus: true, autocomplete: 'email', placeholder: 'voce@empresa.com', class: 'settings-input auth-input' %>
  </div>

  <div class="auth-field">
    <div class="auth-field__row">
      <%= f.label :password, 'Senha', class: 'settings-label' %>
      <%= link_to 'Esqueceu a senha?', new_password_path(resource_name), class: 'auth-quiet-link' %>
    </div>
    <%= render 'devise/shared/password_field', form: f, attribute: :password, options: { autocomplete: 'current-password' } %>
  </div>

  <% if devise_mapping.rememberable? %>
    <label class="auth-check">
      <%= f.check_box :remember_me, class: 'auth-check__input' %>
      <span>Manter conectado neste dispositivo</span>
    </label>
  <% end %>

  <%= f.button 'Entrar', type: 'submit', name: nil, class: workspace_submit_class(:primary, 'auth-submit'), data: { turbo_submits_with: 'Entrando…' } %>
<% end %>

<p class="auth-footer">
  Ainda não tem conta?
  <%= link_to 'Criar conta', new_registration_path(resource_name), class: 'workspace-link' %>
</p>
