<% content_for :title, 'Entrar · LeadPulse' %>

<h1 class="auth-title">Entrar</h1>
<p class="auth-description">Acesse o painel de validação da sua empresa.</p>

<%= render 'devise/shared/messages' %>

<%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: 'auth-form' }) do |f| %>
  <div>
    <%= f.label :email, 'E-mail corporativo', class: 'settings-label' %>
    <%= f.email_field :email, autofocus: true, autocomplete: 'email', placeholder: 'voce@empresa.com', class: 'settings-input' %>
  </div>

  <div>
    <div class="flex items-baseline justify-between">
      <%= f.label :password, 'Senha', class: 'settings-label' %>
      <%= link_to 'Esqueceu a senha?', new_password_path(resource_name), class: 'workspace-link text-[0.8125rem]' %>
    </div>
    <%= f.password_field :password, autocomplete: 'current-password', class: 'settings-input' %>
  </div>

  <% if devise_mapping.rememberable? %>
    <label class="settings-check">
      <%= f.check_box :remember_me %>
      <span>Manter conectado neste dispositivo</span>
    </label>
  <% end %>

  <%= f.submit 'Entrar', class: workspace_submit_class(:primary), data: { turbo_submits_with: 'Entrando…' } %>
<% end %>

<p class="auth-footer">
  Ainda não tem conta?
  <%= link_to 'Criar conta', new_registration_path(resource_name), class: 'workspace-link' %>
</p>
