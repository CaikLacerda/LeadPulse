<% content_for :title, 'Recuperar acesso · LeadPulse' %>

<h1 class="auth-title">Recuperar acesso</h1>
<p class="auth-description">Informe o e-mail da conta para receber o link de redefinição de senha.</p>

<%= render 'devise/shared/messages', resource: resource %>

<%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: 'auth-form' }) do |f| %>
  <div>
    <%= f.label :email, 'E-mail corporativo', class: 'settings-label' %>
    <%= f.email_field :email, autofocus: true, autocomplete: 'email', placeholder: 'voce@empresa.com', class: 'settings-input' %>
  </div>

  <%= f.submit 'Enviar link de redefinição', class: workspace_submit_class(:primary), data: { turbo_submits_with: 'Enviando…' } %>
<% end %>

<p class="auth-footer">
  Lembrou a senha?
  <%= link_to 'Voltar para o login', new_session_path(resource_name), class: 'workspace-link' %>
</p>
