<% content_for :title, 'Nova senha · LeadPulse' %>

<h1 class="auth-title">Definir nova senha</h1>
<p class="auth-description">Escolha uma nova senha para voltar ao painel.</p>

<%= render 'devise/shared/messages', resource: resource %>

<%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: 'auth-form' }) do |f| %>
  <%= f.hidden_field :reset_password_token %>

  <div>
    <%= f.label :password, 'Nova senha', class: 'settings-label' %>
    <%= f.password_field :password, autofocus: true, autocomplete: 'new-password', class: 'settings-input', aria: { describedby: 'password_hint' } %>
    <% if @minimum_password_length %>
      <p class="settings-field-hint" id="password_hint">Mínimo de <%= @minimum_password_length %> caracteres.</p>
    <% end %>
  </div>

  <div>
    <%= f.label :password_confirmation, 'Confirmar nova senha', class: 'settings-label' %>
    <%= f.password_field :password_confirmation, autocomplete: 'new-password', class: 'settings-input' %>
  </div>

  <%= f.submit 'Salvar nova senha', class: workspace_submit_class(:primary), data: { turbo_submits_with: 'Salvando…' } %>
<% end %>

<p class="auth-footer">
  <%= link_to 'Voltar para o login', new_session_path(resource_name), class: 'workspace-link' %>
</p>
