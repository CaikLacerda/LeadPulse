<% signup = variant == 'signup' %>
<aside class="auth-brand" aria-label="Sobre o LeadPulse">
  <div class="auth-brand__inner">
    <%= link_to root_path, class: 'auth-brand__logo' do %>
      <span class="app-logo-mark" aria-hidden="true"><i class="fa-solid fa-bolt"></i></span>
      <span class="app-logo-text">LeadPulse</span>
    <% end %>

    <div class="auth-brand__body">
      <p class="auth-brand__eyebrow"><%= signup ? 'Sua primeira operação' : 'Da conversa à evidência' %></p>
      <p class="auth-brand__headline"><%= signup ? 'Sua próxima validação começa aqui.' : 'Encontre. Ligue. Valide com confiança.' %></p>
      <p class="auth-brand__lead"><%= signup ? 'Organize sua empresa, conecte as integrações e prepare o primeiro lote.' : 'Chamadas por IA e resultados que sua equipe pode conferir.' %></p>

      <%= render 'shared/product_screenshot',
            image: (signup ? 'produto-lote' : 'produto-chamada'), width: 1200, small_width: 640,
            height: (signup ? 529 : 582), sizes: '(min-width: 1024px) 460px, 1px',
            css_class: 'auth-product',
            alt: (signup ? 'Registros de um lote real do LeadPulse, com status e tentativas por empresa.' : 'Tela real da auditoria de chamadas do LeadPulse, com conversa e revisão humana.'),
            caption: (signup ? 'Lote de validação · dados de demonstração' : 'Auditoria de chamadas · dados de demonstração') %>

      <% if signup %>
        <ol class="auth-steps">
          <% [
            ['Criar conta', 'Seu acesso à operação.'],
            ['Configurar empresa', 'Conecte as integrações da sua empresa.'],
            ['Começar validação', 'Busque fornecedores ou importe uma planilha.']
          ].each_with_index do |(title, description), index| %>
            <li class="auth-steps__item" <%= tag.attributes(aria: { current: ('step' if index.zero?) }) %>>
              <span class="auth-steps__number" aria-hidden="true"><%= index + 1 %></span>
              <span class="auth-steps__text">
                <span class="auth-steps__title"><%= title %></span>
                <span class="auth-steps__description"><%= description %></span>
              </span>
            </li>
          <% end %>
        </ol>
      <% else %>
        <ul class="auth-benefits">
          <% [
            ['fa-magnifying-glass', 'Buscar', 'Encontre empresas por segmento e região.'],
            ['fa-phone', 'Validar', 'Confirme contato e interesse por voz com IA.'],
            ['fa-list-check', 'Auditar', 'Confira a conversa e revise cada resultado.']
          ].each do |icon, title, description| %>
            <li>
              <span class="auth-benefits__icon" aria-hidden="true"><i class="fa-solid <%= icon %>"></i></span>
              <span><strong><%= title %></strong><span class="auth-benefits__description"><%= description %></span></span>
            </li>
          <% end %>
        </ul>
      <% end %>
    </div>

    <footer class="auth-legal">
      <span>© <%= Date.current.year %> LeadPulse</span>
      <%= link_to 'Termos', terms_path %>
      <%= link_to 'Privacidade', privacy_path %>
    </footer>
  </div>
</aside>
