<%# Campo de senha com o botão "Mostrar senha" (password_visibility_controller). Sem JavaScript o botão continua oculto. %>
<div class="auth-password" data-controller="password-visibility" data-action="turbo:before-cache@document->password-visibility#hide submit@window->password-visibility#hide turbo:submit-start@document->password-visibility#hide">
  <%= form.password_field attribute, **local_assigns.fetch(:options, {}), class: 'settings-input auth-input', data: { password_visibility_target: 'input' } %>
  <button type="button"
          class="auth-password__toggle"
          hidden
          aria-label="Mostrar senha"
          aria-pressed="false"
          aria-controls="<%= form.field_id(attribute) %>"
          data-password-visibility-target="button"
          data-action="password-visibility#toggle">
    <i class="fa-solid fa-eye" aria-hidden="true" data-password-visibility-target="icon"></i>
  </button>
</div>
