<div class="mx-auto w-full max-w-2xl px-5 py-10 sm:px-8">
  <%= link_to 'Voltar ao painel', root_path, class: 'mb-7 inline-block text-sm font-semibold text-blue-700 hover:underline' %>

  <h1 class="text-3xl font-black text-slate-950">Minha conta</h1>
  <p class="mt-2 text-sm leading-6 text-slate-500">Atualize seu e-mail ou altere a senha de acesso.</p>

  <div class="mt-8 border border-slate-200 bg-white p-6 shadow-sm">
    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }, class: 'space-y-5') do |f| %>
      <%= render 'devise/shared/error_messages', resource: resource %>

      <div>
        <%= f.label :email, 'E-mail', class: 'settings-label' %>
        <%= f.email_field :email, autofocus: true, autocomplete: 'email', class: 'settings-input' %>
      </div>

      <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
        <p class="text-sm text-amber-700">Aguardando confirmação do novo e-mail: <%= resource.unconfirmed_email %>.</p>
      <% end %>

      <div>
        <%= f.label :password, 'Nova senha', class: 'settings-label' %>
        <%= f.password_field :password, autocomplete: 'new-password', class: 'settings-input' %>
        <p class="mt-1 text-xs text-slate-500">Deixe em branco para manter a senha atual<%= "; mínimo de #{@minimum_password_length} caracteres" if @minimum_password_length %>.</p>
      </div>

      <div>
        <%= f.label :password_confirmation, 'Confirme a nova senha', class: 'settings-label' %>
        <%= f.password_field :password_confirmation, autocomplete: 'new-password', class: 'settings-input' %>
      </div>

      <div>
        <%= f.label :current_password, 'Senha atual', class: 'settings-label' %>
        <%= f.password_field :current_password, autocomplete: 'current-password', class: 'settings-input' %>
        <p class="mt-1 text-xs text-slate-500">Necessária para confirmar as alterações.</p>
      </div>

      <%= f.submit 'Salvar alterações', class: workspace_submit_class(:primary) %>
    <% end %>
  </div>

  <div class="mt-8 border border-rose-200 bg-rose-50 p-6">
    <h2 class="text-base font-black text-rose-950">Excluir minha conta</h2>
    <p class="mt-2 text-sm leading-6 text-rose-800">Essa ação remove sua conta e os dados locais associados. Ela não pode ser desfeita.</p>
    <%= button_to 'Excluir conta', registration_path(resource_name),
        method: :delete,
        form: { data: { turbo_confirm: 'Tem certeza de que deseja excluir sua conta?' } },
        class: 'mt-4 inline-flex h-10 items-center justify-center border border-rose-700 bg-rose-700 px-4 text-sm font-bold text-white transition hover:bg-rose-800' %>
  </div>
</div>
