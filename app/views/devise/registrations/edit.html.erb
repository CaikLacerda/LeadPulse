<% content_for :title, 'Minha conta · LeadPulse' %>
<% workspace_breadcrumbs 'Minha conta' %>

<%= workspace_page do %>
  <%= workspace_page_header(title: 'Minha conta', description: 'E-mail de acesso e senha do seu usuário.') %>

  <%= settings_panel(classes: 'mb-6') do %>
    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
      <div class="px-6 pt-5"><%= render 'devise/shared/error_messages', resource: resource %></div>

      <%= settings_section(title: 'Acesso', description: 'E-mail usado para entrar no LeadPulse.') do %>
        <%= f.label :email, 'E-mail', class: 'settings-label' %>
        <%= f.email_field :email, autocomplete: 'email', class: 'settings-input' %>
        <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
          <p class="settings-field-hint text-warning-fg">Aguardando confirmação do novo e-mail: <%= resource.unconfirmed_email %>.</p>
        <% end %>
      <% end %>

      <%= settings_section(title: 'Senha', description: 'Deixe em branco para manter a senha atual.') do %>
        <div class="settings-fields settings-fields--2">
          <div class="settings-field">
            <%= f.label :password, 'Nova senha', class: 'settings-label' %>
            <%= f.password_field :password, autocomplete: 'new-password', class: 'settings-input' %>
            <% if @minimum_password_length %>
              <p class="settings-field-hint">Mínimo de <%= @minimum_password_length %> caracteres.</p>
            <% end %>
          </div>
          <div class="settings-field">
            <%= f.label :password_confirmation, 'Confirmar nova senha', class: 'settings-label' %>
            <%= f.password_field :password_confirmation, autocomplete: 'new-password', class: 'settings-input' %>
          </div>
        </div>
      <% end %>

      <%= settings_section(title: 'Confirmação', description: 'Necessária para salvar qualquer alteração.') do %>
        <%= f.label :current_password, 'Senha atual', class: 'settings-label' %>
        <%= f.password_field :current_password, autocomplete: 'current-password', class: 'settings-input max-w-sm' %>
      <% end %>

      <div class="settings-panel__footer">
        <div class="settings-panel__footer-actions">
          <%= f.submit 'Salvar alterações', class: workspace_submit_class(:primary), data: { turbo_submits_with: 'Salvando…' } %>
        </div>
      </div>
    <% end %>
  <% end %>

  <%= settings_panel do %>
    <div class="settings-section">
      <div>
        <h2 class="settings-section__title">Excluir conta</h2>
        <p class="settings-section__description">Remove sua conta e os dados locais associados. Não pode ser desfeito.</p>
      </div>
      <div>
        <%= button_to 'Excluir minha conta', registration_path(resource_name),
            method: :delete,
            form: { data: { turbo_confirm: 'Sua conta e os dados locais associados serão removidos. Essa ação não pode ser desfeita.', turbo_confirm_title: 'Excluir sua conta?', turbo_confirm_confirm_label: 'Excluir conta', turbo_confirm_variant: 'danger' } },
            class: workspace_button_class(:danger) %>
      </div>
    </div>
  <% end %>
<% end %>
