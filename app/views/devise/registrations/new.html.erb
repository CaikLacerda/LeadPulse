<% content_for :title, 'Criar conta · LeadPulse' %>

<h1 class="auth-title">Criar conta</h1>
<p class="auth-description">Configure a operação de busca e validação de fornecedores da sua empresa.</p>

<%= render 'devise/shared/messages', resource: resource %>

<%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: 'auth-form' }) do |f| %>
  <div>
    <%= f.label :name, 'Nome completo', class: 'settings-label' %>
    <%= f.text_field :name, autofocus: true, autocomplete: 'name', class: 'settings-input' %>
  </div>

  <div>
    <%= f.label :email, 'E-mail corporativo', class: 'settings-label' %>
    <%= f.email_field :email, autocomplete: 'email', placeholder: 'voce@empresa.com', class: 'settings-input' %>
  </div>

  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <%= f.label :password, 'Senha', class: 'settings-label' %>
      <%= f.password_field :password, autocomplete: 'new-password', class: 'settings-input', aria: { describedby: 'password_hint' } %>
    </div>
    <div>
      <%= f.label :password_confirmation, 'Confirmar senha', class: 'settings-label' %>
      <%= f.password_field :password_confirmation, autocomplete: 'new-password', class: 'settings-input' %>
    </div>
    <% if @minimum_password_length %>
      <p class="settings-field-hint !mt-0 sm:col-span-2" id="password_hint">Mínimo de <%= @minimum_password_length %> caracteres.</p>
    <% end %>
  </div>

  <p class="text-[0.8125rem] leading-5 text-fg-muted">
    Ao criar a conta, você concorda com os
    <%= link_to 'Termos de Serviço', terms_path, class: 'workspace-link workspace-link--muted underline', target: '_blank', rel: 'noopener' %>
    e a
    <%= link_to 'Política de Privacidade', privacy_path, class: 'workspace-link workspace-link--muted underline', target: '_blank', rel: 'noopener' %>.
  </p>

  <%= f.submit 'Criar conta', class: workspace_submit_class(:primary), data: { turbo_submits_with: 'Criando conta…' } %>
<% end %>

<p class="auth-footer">
  Já tem conta?
  <%= link_to 'Entrar', new_session_path(resource_name), class: 'workspace-link' %>
</p>
