<%= platform_settings_page(title: 'Configurações', description: 'Dados da empresa, provedores de voz e IA e acesso à API.', tutorial_key: :platform_settings_twilio) do %>
  <%= settings_panel do %>
    <%= form_with model: current_user, url: twilio_platform_settings_path, method: :patch, local: true do |f| %>
      <%= settings_feedback_messages %>

      <%= settings_section(title: 'Credenciais', description: 'Autenticam as chamadas feitas pela conta Twilio.', data: { tutorial_id: 'twilio-credentials' }) do %>
        <div class="settings-fields settings-fields--2">
          <div class="settings-field">
            <%= render 'field_label', form: f, field: :validation_twilio_account_sid, text: 'Account SID', help: 'Identificador da conta Twilio.', required: true %>
            <%= f.text_field :validation_twilio_account_sid, class: 'settings-input settings-input--mono', required: true, autocomplete: 'off' %>
          </div>

          <div class="settings-field">
            <%= render 'field_label', form: f, field: :validation_twilio_auth_token, text: 'Auth Token', help: 'Chave secreta. Não é exibida depois de salva.', required: true %>
            <%= f.password_field :validation_twilio_auth_token, value: nil, placeholder: 'Informe o Auth Token para salvar', autocomplete: 'new-password', class: 'settings-input', required: true %>
          </div>

          <div class="settings-field settings-field--full">
            <%= render 'field_label', form: f, field: :validation_twilio_webhook_base_url, text: 'Webhook base URL', help: 'Endereço público que recebe os eventos de chamada e abre o fluxo de voz.', required: true %>
            <%= f.text_field :validation_twilio_webhook_base_url, class: 'settings-input settings-input--mono', required: true, placeholder: 'https://' %>
          </div>
        </div>
      <% end %>

      <%= settings_section(title: 'Números de origem', description: 'Números habilitados para originar as chamadas de validação.', data: { tutorial_id: 'twilio-numbers' }) do %>
        <%= render 'field_label', form: f, field: :validation_twilio_phone_numbers_text, text: 'Números Twilio ativos', help: 'Um número por linha.', required: true %>
        <%= f.text_area :validation_twilio_phone_numbers_text,
            value: current_user.validation_twilio_phone_numbers_text,
            rows: 5,
            placeholder: "13527176703\n13520000000",
            class: 'settings-input settings-input--mono', required: true %>
      <% end %>

      <div class="settings-panel__footer">
        <p class="settings-panel__footer-note"><span class="text-danger-fg">*</span> Obrigatórios para habilitar as chamadas.</p>
        <div class="settings-panel__footer-actions">
          <%= f.submit 'Salvar alterações', class: workspace_submit_class(:primary), data: { tutorial_id: 'twilio-submit', turbo_submits_with: 'Salvando…' } %>
        </div>
      </div>
    <% end %>
  <% end %>
<% end %>
