<%= platform_settings_page(title: 'Integrações', description: 'Provedores de voz e IA, token da API de validação e tokens de BI da empresa.', tutorial_key: :platform_settings_api_token) do %>
  <% generated_api_token = flash[:generated_api_token].presence %>

  <%= settings_panel do %>
    <%= settings_feedback_messages %>

    <%= settings_section(title: 'Token atual', description: 'Autentica integrações externas (ERP, CRM, backoffice) na API por Bearer token.', data: { tutorial_id: 'token-status' }) do %>
      <dl class="workspace-kv mb-5">
        <div>
          <dt>Conta na API</dt>
          <dd class="workspace-mono"><%= current_account.validation_account_id.presence || '—' %></dd>
        </div>
        <div>
          <dt>Prefixo</dt>
          <dd class="workspace-mono"><%= current_account.validation_api_token_prefix.presence || '—' %></dd>
        </div>
        <div>
          <dt>Criado em</dt>
          <dd class="tabular-nums"><%= workspace_datetime(current_account.validation_api_token_created_at) %></dd>
        </div>
      </dl>

      <% if generated_api_token.present? %>
        <div class="workspace-callout workspace-callout--warning flex-col !items-stretch !gap-3"
             data-controller="copy-to-clipboard"
             data-copy-to-clipboard-source-value="generated_api_token"
             data-copy-to-clipboard-default-text-value="<%= I18n.t('platform_settings.api_token.copy') %>"
             data-copy-to-clipboard-success-text-value="<%= I18n.t('platform_settings.api_token.copied') %>">
          <div>
            <label for="generated_api_token" class="font-medium text-fg"><%= t('platform_settings.api_token.copy_now') %></label>
            <p class="mt-0.5">Ele aparece somente agora. Depois desta tela, o LeadPulse mostra apenas o prefixo.</p>
          </div>
          <div class="flex flex-col gap-2 sm:flex-row">
            <input type="text" id="generated_api_token" value="<%= generated_api_token %>" readonly class="settings-input settings-input--mono">
            <button type="button"
                    class="<%= workspace_button_class(:secondary) %>"
                    data-copy-to-clipboard-target="button"
                    data-action="copy-to-clipboard#copy">
              <%= t('platform_settings.api_token.copy') %>
            </button>
          </div>
        </div>
      <% else %>
        <label for="current_api_token" class="settings-label">Token</label>
        <input type="text" id="current_api_token" value="<%= current_account.masked_validation_api_token %>" readonly class="settings-input settings-input--mono" aria-describedby="current_api_token_hint">
        <p class="settings-field-hint" id="current_api_token_hint">O valor completo não fica visível no painel. Gere um novo token se precisar copiá-lo.</p>
      <% end %>
    <% end %>

    <%= form_with url: api_token_platform_settings_path, method: :post, local: true, data: { turbo_confirm: 'O token atual será revogado e as integrações que o usam deixarão de funcionar até receberem o novo valor.', turbo_confirm_title: 'Gerar novo token?', turbo_confirm_confirm_label: 'Gerar e revogar o atual', turbo_confirm_variant: 'danger' } do %>
      <%= settings_section(title: 'Gerar novo token', description: 'Ao gerar um novo token, o anterior é revogado automaticamente na API.') do %>
        <label for="token_name" class="settings-label">Nome do token</label>
        <p class="settings-field-hint -mt-1 mb-2">Rótulo interno para identificar o token.</p>
        <input type="text" id="token_name" name="token_name" value="leadpulse_web" class="settings-input max-w-sm">
      <% end %>

      <div class="settings-panel__footer">
        <p class="settings-panel__footer-note">O token atual deixa de funcionar imediatamente.</p>
        <div class="settings-panel__footer-actions">
          <button type="submit" class="<%= workspace_button_class(:primary) %>" data-tutorial-id="token-submit" data-turbo-submits-with="Gerando…">
            Gerar novo token
          </button>
        </div>
      </div>
    <% end %>
  <% end %>
<% end %>
