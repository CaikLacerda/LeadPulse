<%= platform_settings_page(title: 'Configurações', description: 'Dados da empresa, provedores de voz e IA e acesso à API.', tutorial_key: :platform_settings_openai) do %>
  <%= settings_panel do %>
    <%= form_with model: current_user, url: openai_platform_settings_path, method: :patch, local: true do |f| %>
      <%= settings_feedback_messages %>

      <%= settings_section(title: 'Chave de acesso', description: 'Usada pela IA conversacional, voz e classificação das respostas.', data: { tutorial_id: 'openai-api-key' }) do %>
        <%= render 'field_label', form: f, field: :validation_openai_api_key, text: 'API Key', help: 'Não é exibida depois de salva. Informe novamente para alterar.', required: true %>
        <%= f.password_field :validation_openai_api_key, value: nil, placeholder: 'Informe a API Key para salvar', autocomplete: 'new-password', class: 'settings-input', required: true %>
      <% end %>

      <%= settings_section(title: 'Perfil de voz', description: 'Modelo, voz e ritmo usados nas conversas telefônicas.', data: { tutorial_id: 'openai-profile' }) do %>
        <div class="settings-fields settings-fields--3">
          <div class="settings-field">
            <%= render 'field_label', form: f, field: :validation_openai_realtime_model, text: 'Modelo', required: true %>
            <%= f.select :validation_openai_realtime_model,
                User::REALTIME_MODELS,
                {},
                class: 'settings-input', required: true %>
          </div>

          <div class="settings-field">
            <%= render 'field_label', form: f, field: :validation_openai_realtime_voice, text: 'Voz', required: true %>
            <%= f.text_field :validation_openai_realtime_voice, class: 'settings-input', required: true %>
          </div>

          <div class="settings-field">
            <%= render 'field_label', form: f, field: :validation_openai_realtime_output_speed, text: 'Velocidade', required: true %>
            <%= f.number_field :validation_openai_realtime_output_speed, step: 0.01, min: 0.25, max: 1.5, class: 'settings-input', required: true %>
          </div>

          <p class="settings-field-hint settings-field--full !mt-0">A velocidade vai de 0,25 a 1,5. Valores menores deixam a fala mais calma.</p>

          <div class="settings-field settings-field--full">
            <%= render 'field_label', form: f, field: :validation_openai_style_instructions, text: 'Instruções de estilo', help: 'Tom, postura e comportamento da IA durante a conversa.' %>
            <%= f.text_area :validation_openai_style_instructions, rows: 5, class: 'settings-input' %>
          </div>
        </div>
      <% end %>

      <div class="settings-panel__footer">
        <p class="settings-panel__footer-note"><span class="text-danger-fg">*</span> Obrigatórios para habilitar a IA conversacional.</p>
        <div class="settings-panel__footer-actions">
          <%= f.submit 'Salvar alterações', class: workspace_submit_class(:primary), data: { tutorial_id: 'openai-submit', turbo_submits_with: 'Salvando…' } %>
        </div>
      </div>
    <% end %>
  <% end %>
<% end %>
