<%= platform_settings_page(title: 'Empresa', description: 'Dados da empresa usados nas chamadas, nos relatórios e na API de validação.', nav: :none, tutorial_key: :platform_settings_company) do %>
  <%= settings_panel do %>
    <%= form_with model: current_account, url: company_platform_settings_path, method: :patch, local: true do |f| %>
      <%= settings_feedback_messages %>

      <%= settings_section(title: 'Empresa', description: 'Identificação da conta no LeadPulse e na API de validação.', data: { tutorial_id: 'company-fields' }) do %>
        <div class="settings-fields settings-fields--2">
          <div class="settings-field">
            <%= render 'field_label', form: f, field: :validation_company_name, text: 'Nome da empresa', help: 'Nome principal da conta no LeadPulse e na API.', required: true %>
            <%= f.text_field :validation_company_name, value: current_account.validation_company_name_value, class: 'settings-input', required: true %>
          </div>

          <div class="settings-field">
            <%= render 'field_label', form: f, field: :validation_spoken_company_name, text: 'Nome falado pela IA', help: 'Como a IA cita a empresa durante as ligações.', required: true %>
            <%= f.text_field :validation_spoken_company_name, value: current_account.validation_spoken_company_name_value, class: 'settings-input', required: true %>
          </div>

          <div class="settings-field">
            <%= render 'field_label', form: f, field: :validation_owner_name, text: 'Responsável', help: 'Pessoa de referência para a conta.', required: true %>
            <%= f.text_field :validation_owner_name, value: current_account.validation_owner_name_value, class: 'settings-input', required: true %>
          </div>

          <div class="settings-field">
            <%= render 'field_label', form: f, field: :validation_owner_email, text: 'E-mail do responsável', help: 'Contato administrativo da integração.', required: true %>
            <%= f.email_field :validation_owner_email, value: current_account.validation_owner_email_value, class: 'settings-input', required: true %>
          </div>
        </div>
      <% end %>

      <%= settings_section(title: 'Apresentação na ligação', description: 'Fatos públicos que a IA pode usar para explicar quem está ligando e por quê.') do %>
        <%= render 'field_label', form: f, field: :validation_calling_profile, text: 'Informações institucionais para a ligação', help: 'Não inclua senhas, tokens, dados pessoais, preços confidenciais ou instruções para a IA.', required: false %>
        <%= f.text_area :validation_calling_profile, value: current_account.validation_calling_profile, class: 'settings-input min-h-36', rows: 6, maxlength: 1500, aria: { describedby: 'calling_profile_limit' }, placeholder: 'Ex.: A empresa atua com... Esta ligação busca... Para dúvidas não cobertas, a equipe responsável pode retornar pelo canal oficial.' %>
        <p class="settings-field-hint" id="calling_profile_limit">Máximo de 1.500 caracteres. A IA usa somente os fatos informados aqui e retoma a validação após responder.</p>
      <% end %>

      <%= settings_section(title: 'Conta na API', description: 'Identificador gerado quando a empresa é provisionada.', data: { tutorial_id: 'company-account' }) do %>
        <dl class="workspace-kv">
          <div>
            <dt>ID da conta</dt>
            <dd class="workspace-mono"><%= current_account.validation_account_id.presence || '—' %></dd>
          </div>
          <div>
            <dt>Situação</dt>
            <dd><%= current_account.validation_account_id.present? ? status_badge('Provisionada', tone: :success) : status_badge('Não provisionada', tone: :warning) %></dd>
          </div>
        </dl>
      <% end %>

      <div class="settings-panel__footer">
        <p class="settings-panel__footer-note"><span class="text-danger-fg">*</span> Obrigatórios para provisionar e salvar a empresa na API.</p>
        <div class="settings-panel__footer-actions">
          <%= f.submit 'Salvar alterações', class: workspace_submit_class(:primary), data: { tutorial_id: 'company-submit', turbo_submits_with: 'Salvando…' } %>
        </div>
      </div>
    <% end %>
  <% end %>
<% end %>
