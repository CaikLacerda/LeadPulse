<% tabs = [
  [t('platform_settings.tabs.twilio'), twilio_platform_settings_path],
  [t('platform_settings.tabs.openai'), openai_platform_settings_path],
  [t('platform_settings.tabs.api_token'), api_token_platform_settings_path]
] %>

<nav class="settings-tab-rail mb-6" aria-label="Integrações" data-tutorial-id="settings-tabs">
  <% tabs.each do |label, path| %>
    <% active = current_page?(path) %>
    <%= link_to label, path,
        class: "settings-tab #{'settings-tab--active' if active}",
        aria: { current: (active ? 'page' : nil) },
        data: { turbo_frame: 'platform_settings_content', turbo_action: 'advance' } %>
  <% end %>
</nav>
