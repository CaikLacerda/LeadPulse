<div class="settings-label-row">
  <%= form.label field, class: 'settings-label' do %>
    <%= text %><% if local_assigns[:required] %><span class="settings-required-mark" aria-hidden="true">*</span><span class="sr-only"> (<%= t('platform_settings.required_field') %>)</span><% end %>
  <% end %>
  <% if local_assigns[:help].present? %>
    <p class="settings-field-hint" id="<%= form.field_id(field) %>_hint"><%= help %></p>
  <% end %>
</div>
